{% comment %}
  Jotar Footwear - Trending Collection / Editorial Section
{% endcomment %}

<section class="jotar-trending" id="jotar-trending-{{ section.id }}">
  <div class="jotar-container">
    <div class="jotar-trending__grid">
      <!-- Left Content Column -->
      <div class="jotar-trending__content">
        {%- if section.settings.eyebrow != blank -%}
          <span class="jotar-eyebrow">{{ section.settings.eyebrow }}</span>
        {%- endif -%}

        <h2 class="jotar-trending__heading">
          STREET <span class="jotar-text-accent">READY</span><br>EVERYDAY COMFORT
        </h2>

        {%- if section.settings.btn_label != blank -%}
          <div>
            <a
              href="{{ section.settings.btn_url | default: routes.all_products_collection_url }}"
              class="jotar-btn jotar-btn--primary"
            >
              {{ section.settings.btn_label }}
            </a>
          </div>
        {%- endif -%}
      </div>

      <!-- Right Editorial Gallery: 3 Images -->
      <div class="jotar-trending__gallery">
        <!-- Image 1 -->
        <div class="jotar-trending__image-wrap">
          {%- if section.settings.image_1 != blank -%}
            {{
              section.settings.image_1
              | image_url: width: 600
              | image_tag:
                class: 'jotar-trending__image',
                loading: 'lazy',
                alt: 'Editorial Look 1'
            }}
          {%- else -%}
            <img
              src="{{ 'jotar-trend-01.jpg' | asset_url }}"
              alt="Editorial Look 1"
              class="jotar-trending__image"
              loading="lazy"
            >
          {%- endif -%}
        </div>

        <!-- Image 2 -->
        <div class="jotar-trending__image-wrap">
          {%- if section.settings.image_2 != blank -%}
            {{
              section.settings.image_2
              | image_url: width: 600
              | image_tag:
                class: 'jotar-trending__image',
                loading: 'lazy',
                alt: 'Editorial Look 2'
            }}
          {%- else -%}
            <img
              src="{{ 'jotar-trend-02.jpg' | asset_url }}"
              alt="Editorial Look 2"
              class="jotar-trending__image"
              loading="lazy"
            >
          {%- endif -%}
        </div>

        <!-- Image 3 -->
        <div class="jotar-trending__image-wrap">
          {%- if section.settings.image_3 != blank -%}
            {{
              section.settings.image_3
              | image_url: width: 600
              | image_tag:
                class: 'jotar-trending__image',
                loading: 'lazy',
                alt: 'Editorial Look 3'
            }}
          {%- else -%}
            <img
              src="{{ 'jotar-trend-03.jpg' | asset_url }}"
              alt="Editorial Look 3"
              class="jotar-trending__image"
              loading="lazy"
            >
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Trending Editorial",
  "tag": "section",
  "class": "section-jotar-trending",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "TRENDING COLLECTION"
    },
    {
      "type": "text",
      "id": "btn_label",
      "label": "Button Label",
      "default": "SHOP COLLECTION"
    },
    {
      "type": "url",
      "id": "btn_url",
      "label": "Button URL"
    },
    {
      "type": "image_picker",
      "id": "image_1",
      "label": "Editorial Image 1"
    },
    {
      "type": "image_picker",
      "id": "image_2",
      "label": "Editorial Image 2"
    },
    {
      "type": "image_picker",
      "id": "image_3",
      "label": "Editorial Image 3"
    }
  ],
  "presets": [
    {
      "name": "Trending Editorial"
    }
  ]
}
{% endschema %}
