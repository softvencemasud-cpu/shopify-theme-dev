<style>
  /* ==========================================================================
     JOTAR / NOVA GALLERY PAGE STYLES
     ========================================================================== */
  .jotar-gallery {
    --gallery-bg: #ffffff;
    --gallery-card-bg: #f5f5f7;
    --gallery-border-radius: 12px;
    --gallery-text-main: #111111;
    --gallery-text-muted: #666666;
    background-color: var(--gallery-bg);
    color: var(--gallery-text-main);
    font-family: var(--font-body-family, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif);
    padding-bottom: 80px;
    overflow: hidden;
  }

  .jotar-gallery-container {
    width: 100%;
    max-width: 1440px;
    margin: 0 auto;
    padding: 0 32px;
    box-sizing: border-box;
  }

  /* Breadcrumbs */
  .jotar-gallery-breadcrumbs-wrap {
    padding: 24px 0 12px;
  }

  .jotar-gallery-breadcrumbs {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    color: var(--gallery-text-muted);
  }

  .jotar-gallery-breadcrumbs a {
    color: var(--gallery-text-muted);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .jotar-gallery-breadcrumbs a:hover {
    color: var(--gallery-text-main);
  }

  .jotar-gallery-breadcrumbs__sep {
    color: #999999;
  }

  .jotar-gallery-breadcrumbs__current {
    color: var(--gallery-text-main);
    font-weight: 500;
  }

  /* Hero Header */
  .jotar-gallery-hero {
    padding: 10px 0 32px;
  }

  .jotar-gallery-hero__wrapper {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 40px;
    background: linear-gradient(135deg, #f9f9fb 0%, #f1f2f6 100%);
    border-radius: 20px;
    padding: 40px 50px;
    position: relative;
    overflow: hidden;
