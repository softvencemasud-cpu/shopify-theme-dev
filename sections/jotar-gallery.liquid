{% comment %}
  Jotar / NOVA - Gallery Page Section
  Exact match to reference design with filter tabs, masonry grid, expand icons, and interactive modal lightbox.
{% endcomment %}

<div class="jotar-gallery" id="jotar-gallery-{{ section.id }}">
  <!-- 1. BREADCRUMBS -->
  {%- if section.settings.show_breadcrumbs -%}
    <div class="jotar-gallery-breadcrumbs-wrap">
      <div class="jotar-gallery-container">
        <nav class="jotar-gallery-breadcrumbs" aria-label="Breadcrumb">
          <a href="{{ routes.root_url }}">Home</a>
          <span class="jotar-gallery-breadcrumbs__sep" aria-hidden="true">&rsaquo;</span>
          <span class="jotar-gallery-breadcrumbs__current">{{ section.settings.breadcrumb_title | default: 'Gallery' }}</span>
        </nav>
      </div>
    </div>
  {%- endif -%}

  <!-- 2. HERO HEADER BANNER -->
  <section class="jotar-gallery-hero">
    <div class="jotar-gallery-container">
      <div class="jotar-gallery-hero__wrapper">
        <div class="jotar-gallery-hero__content">
          <h1 class="jotar-gallery-hero__title">{{ section.settings.heading | default: 'OUR GALLERY' }}</h1>
          <p class="jotar-gallery-hero__desc">
            {{ section.settings.description | default: 'Explore our world through style and movement.<br>From street to studio — this is NOVA.' }}
          </p>
        </div>
        <div class="jotar-gallery-hero__media">
          {%- if section.settings.hero_image != blank -%}
            {{
              section.settings.hero_image
              | image_url: width: 800
              | image_tag:
                class: 'jotar-gallery-hero__img',
                loading: 'eager',
                alt: section.settings.heading
            }}
          {%- else -%}
            <img
              src="{{ 'jotar-gallery-hero.jpg' | asset_url }}"
              alt="NOVA Gallery Sneaker"
              class="jotar-gallery-hero__img"
              loading="eager"
            >
          {%- endif -%}
        </div>
      </div>
    </div>
  </section>

  <!-- 3. FILTER TABS & TOOLBAR -->
  <div class="jotar-gallery-toolbar-section">
    <div class="jotar-gallery-container">
      <div class="jotar-gallery-toolbar">
        <div class="jotar-gallery-filters" role="tablist" aria-label="Gallery category filters">
          <button
            type="button"
            class="jotar-gallery-filter-btn is-active"
            data-filter="all"
            role="tab"
            aria-selected="true"
          >
            All
          </button>
          <button
            type="button"
            class="jotar-gallery-filter-btn"
            data-filter="lifestyle"
            role="tab"
            aria-selected="false"
          >
            Lifestyle
          </button>
          <button
            type="button"
            class="jotar-gallery-filter-btn"
            data-filter="street"
            role="tab"
            aria-selected="false"
          >
            Street
          </button>
          <button
            type="button"
            class="jotar-gallery-filter-btn"
            data-filter="running"
            role="tab"
            aria-selected="false"
          >
            Running
          </button>
          <button
            type="button"
            class="jotar-gallery-filter-btn"
            data-filter="behind-the-scenes"
            role="tab"
            aria-selected="false"
          >
            Behind the Scenes
          </button>
          <button
            type="button"
            class="jotar-gallery-filter-btn"
            data-filter="events"
            role="tab"
            aria-selected="false"
          >
            Events
          </button>
        </div>

        <div class="jotar-gallery-toolbar__actions">
          <button type="button" class="jotar-gallery-filter-trigger" id="jotar-gallery-filter-trigger">
            <svg class="jotar-gallery-filter-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="4" y1="21" x2="4" y2="14"></line>
              <line x1="4" y1="10" x2="4" y2="3"></line>
              <line x1="12" y1="21" x2="12" y2="12"></line>
              <line x1="12" y1="8" x2="12" y2="3"></line>
              <line x1="20" y1="21" x2="20" y2="16"></line>
              <line x1="20" y1="12" x2="20" y2="3"></line>
              <line x1="1" y1="14" x2="7" y2="14"></line>
              <line x1="9" y1="8" x2="15" y2="8"></line>
              <line x1="17" y1="16" x2="23" y2="16"></line>
            </svg>
            <span>Filter</span>
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- 4. GALLERY GRID SECTION -->
  <section class="jotar-gallery-grid-section">
    <div class="jotar-gallery-container">
      <div class="jotar-gallery-grid" id="jotar-gallery-grid-{{ section.id }}">
        {%- if section.blocks.size > 0 -%}
          {%- for block in section.blocks -%}
            {%- assign item_category = block.settings.category | default: 'lifestyle' | downcase | replace: ' ', '-' -%}
            {%- assign item_span = block.settings.card_size | default: 'standard' -%}
            
            <div
              class="jotar-gallery-item jotar-gallery-item--{{ item_span }}"
              data-category="{{ item_category }}"
              data-index="{{ forloop.index0 }}"
              {{ block.shopify_attributes }}
            >
              <div class="jotar-gallery-card">
                {%- if block.settings.image != blank -%}
                  {{
                    block.settings.image
                    | image_url: width: 1200
                    | image_tag:
                      class: 'jotar-gallery-card__img',
                      loading: 'lazy',
                      alt: block.settings.title | default: 'NOVA Gallery'
                  }}
                  {%- assign img_src = block.settings.image | image_url: width: 1600 -%}
                {%- else -%}
                  {%- assign fallback_img = 'jotar-gallery-01.jpg' -%}
                  {%- if forloop.index == 2 -%}{%- assign fallback_img = 'jotar-gallery-02.jpg' -%}{%- endif -%}
                  {%- if forloop.index == 3 -%}{%- assign fallback_img = 'jotar-prod-04.jpg' -%}{%- endif -%}
                  {%- if forloop.index == 4 -%}{%- assign fallback_img = 'jotar-gallery-04.jpg' -%}{%- endif -%}
                  {%- if forloop.index == 5 -%}{%- assign fallback_img = 'jotar-prod-02.jpg' -%}{%- endif -%}
                  {%- if forloop.index == 6 -%}{%- assign fallback_img = 'jotar-prod-05.jpg' -%}{%- endif -%}
                  {%- if forloop.index == 7 -%}{%- assign fallback_img = 'jotar-gallery-08.jpg' -%}{%- endif -%}
                  {%- if forloop.index == 8 -%}{%- assign fallback_img = 'jotar-prod-03.jpg' -%}{%- endif -%}
                  {%- if forloop.index == 9 -%}{%- assign fallback_img = 'jotar-gallery-10.jpg' -%}{%- endif -%}
                  {%- assign img_src = fallback_img | asset_url -%}
                  <img
                    src="{{ img_src }}"
                    alt="{{ block.settings.title | default: 'NOVA Gallery Item' }}"
                    class="jotar-gallery-card__img"
                    loading="lazy"
                  >
                {%- endif -%}

                <!-- Hover Overlay & Expand Button -->
                <div class="jotar-gallery-card__overlay">
                  <div class="jotar-gallery-card__info">
                    {%- if block.settings.title != blank -%}
                      <h3 class="jotar-gallery-card__title">{{ block.settings.title }}</h3>
                    {%- endif -%}
                    <span class="jotar-gallery-card__badge">{{ block.settings.category | default: 'Lifestyle' }}</span>
                  </div>
                </div>

                <button
                  type="button"
                  class="jotar-gallery-card__zoom-btn"
                  aria-label="Expand image"
                  data-zoom-src="{{ img_src }}"
                  data-zoom-title="{{ block.settings.title | default: 'NOVA Street & Movement' }}"
                  data-zoom-category="{{ block.settings.category | default: 'Lifestyle' }}"
                >
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="15 3 21 3 21 9"></polyline>
                    <polyline points="9 21 3 21 3 15"></polyline>
                    <line x1="21" y1="3" x2="14" y2="10"></line>
                    <line x1="3" y1="21" x2="10" y2="14"></line>
                  </svg>
                </button>
              </div>
            </div>
          {%- endfor -%}
        {%- else -%}
          <!-- DEFAULT GALLERY GRID MATCHING EXACT REFERENCE IMAGE -->
          
          <!-- Column 1: Tall Steps Street Photo -->
          <div class="jotar-gallery-item jotar-gallery-item--tall" data-category="street" data-index="0">
            <div class="jotar-gallery-card">
              <img src="{{ 'jotar-gallery-01.jpg' | asset_url }}" alt="NOVA Urban Street Style" class="jotar-gallery-card__img" loading="lazy">
              <div class="jotar-gallery-card__overlay">
                <div class="jotar-gallery-card__info">
