  .jotar-gallery-hero__content {
    flex: 1;
    max-width: 520px;
    z-index: 2;
  }

  .jotar-gallery-hero__title {
    font-size: clamp(32px, 4.5vw, 54px);
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.02em;
    margin: 0 0 16px 0;
    text-transform: uppercase;
    color: #111111;
  }

  .jotar-gallery-hero__desc {
    font-size: 16px;
    line-height: 1.6;
    color: #555555;
    margin: 0;
  }

  .jotar-gallery-hero__media {
    flex: 1;
    max-width: 580px;
    display: flex;
    justify-content: flex-end;
    align-items: center;
    position: relative;
  }

  .jotar-gallery-hero__img {
    width: 100%;
    max-height: 300px;
