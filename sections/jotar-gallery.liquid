    transition: all 0.2s ease;
    font-family: inherit;
  }

  .jotar-gallery-filter-trigger:hover {
    border-color: #111111;
    background-color: #f9f9fb;
  }

  /* Gallery Grid - Responsive Varied Layout */
  .jotar-gallery-grid-section {
    padding: 0;
  }

  .jotar-gallery-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    grid-auto-rows: 240px;
    gap: 16px;
  }

  .jotar-gallery-item {
    position: relative;
    border-radius: var(--gallery-border-radius);
    overflow: hidden;
    transition: transform 0.35s ease, opacity 0.35s ease;
  }

  /* Tall Column Layout to match reference image */
  .jotar-gallery-item--tall {
    grid-row: span 2;
  }

  .jotar-gallery-item.is-hidden {
    display: none;
    opacity: 0;
    transform: scale(0.95);
  }

  .jotar-gallery-card {
    position: relative;
    width: 100%;
    height: 100%;
    border-radius: var(--gallery-border-radius);
    overflow: hidden;
    background-color: var(--gallery-card-bg);
    cursor: pointer;
  }

  .jotar-gallery-card__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1), filter 0.3s ease;
  }

  .jotar-gallery-card:hover .jotar-gallery-card__img {
    transform: scale(1.05);
  }

  /* Overlay on Hover */
  .jotar-gallery-card__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.7) 0%, rgba(0, 0, 0, 0) 60%);
    opacity: 0;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 20px;
    transition: opacity 0.3s ease;
    box-sizing: border-box;
  }

  .jotar-gallery-card:hover .jotar-gallery-card__overlay {
    opacity: 1;
  }

  .jotar-gallery-card__info {
    transform: translateY(10px);
    transition: transform 0.3s ease;
  }

  .jotar-gallery-card:hover .jotar-gallery-card__info {
    transform: translateY(0);
  }

  .jotar-gallery-card__title {
    color: #ffffff;
    font-size: 16px;
    font-weight: 600;
    margin: 0 0 6px 0;
    letter-spacing: -0.01em;
  }

  .jotar-gallery-card__badge {
    display: inline-block;
    padding: 4px 10px;
    background: rgba(255, 255, 255, 0.2);
    backdrop-filter: blur(8px);
    border-radius: 999px;
    color: #ffffff;
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  /* Expand / Zoom Button on Cards */
  .jotar-gallery-card__zoom-btn {
    position: absolute;
    bottom: 16px;
    left: 16px;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: rgba(0, 0, 0, 0.6);
    backdrop-filter: blur(6px);
    border: none;
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    opacity: 0;
    transform: scale(0.85);
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    z-index: 5;
  }

  .jotar-gallery-card__zoom-btn.is-visible,
  .jotar-gallery-card:hover .jotar-gallery-card__zoom-btn {
    opacity: 1;
    transform: scale(1);
  }

  .jotar-gallery-card__zoom-btn:hover {
    background: #111111;
    color: #ffffff;
    transform: scale(1.1);
  }

  /* ==========================================================================
     LIGHTBOX MODAL
     ========================================================================== */
  .jotar-lightbox {
    position: fixed;
    inset: 0;
    z-index: 999999;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .jotar-lightbox.is-open {
