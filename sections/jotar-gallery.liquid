<script>
  document.addEventListener('DOMContentLoaded', function() {
    const root = document.getElementById('jotar-gallery-{{ section.id }}');
    if (!root) return;

    // 1. FILTER FUNCTIONALITY
    const filterButtons = root.querySelectorAll('.jotar-gallery-filter-btn');
    const galleryItems = root.querySelectorAll('.jotar-gallery-item');

    filterButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        filterButtons.forEach(b => {
          b.classList.remove('is-active');
          b.setAttribute('aria-selected', 'false');
        });
        btn.classList.add('is-active');
        btn.setAttribute('aria-selected', 'true');

        const filterValue = btn.getAttribute('data-filter');

        galleryItems.forEach(item => {
          const itemCat = item.getAttribute('data-category');
          if (filterValue === 'all' || itemCat === filterValue) {
            item.classList.remove('is-hidden');
          } else {
            item.classList.add('is-hidden');
          }
        });
      });
    });

    // 2. LIGHTBOX FUNCTIONALITY
    const lightbox = document.getElementById('jotar-lightbox-{{ section.id }}');
    const lightboxImg = document.getElementById('jotar-lightbox-img');
    const lightboxTitle = document.getElementById('jotar-lightbox-title');
    const lightboxTag = document.getElementById('jotar-lightbox-tag');
    const lightboxCounter = document.getElementById('jotar-lightbox-counter');
    const prevBtn = document.getElementById('jotar-lightbox-prev');
    const nextBtn = document.getElementById('jotar-lightbox-next');
    const closeTriggers = root.querySelectorAll('[data-close-lightbox]');

    let activeItems = [];
    let currentIndex = 0;

    function getVisibleItems() {
      return Array.from(galleryItems).filter(item => !item.classList.contains('is-hidden'));
    }

    function openLightbox(itemElement) {
      activeItems = getVisibleItems();
      currentIndex = activeItems.indexOf(itemElement);
      if (currentIndex === -1) currentIndex = 0;

      updateLightboxContent();
      lightbox.classList.add('is-open');
      lightbox.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
    }

    function closeLightbox() {
      lightbox.classList.remove('is-open');
      lightbox.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
    }

    function updateLightboxContent() {
      if (!activeItems.length) return;
      const currentItem = activeItems[currentIndex];
      const zoomBtn = currentItem.querySelector('.jotar-gallery-card__zoom-btn');
      const imgElem = currentItem.querySelector('.jotar-gallery-card__img');
      
      const imgSrc = zoomBtn ? zoomBtn.getAttribute('data-zoom-src') : imgElem.src;
      const title = zoomBtn ? zoomBtn.getAttribute('data-zoom-title') : (imgElem.alt || 'NOVA Gallery');
      const category = zoomBtn ? zoomBtn.getAttribute('data-zoom-category') : 'Lifestyle';

      lightboxImg.src = imgSrc;
      lightboxImg.alt = title;
      lightboxTitle.textContent = title;
      lightboxTag.textContent = category;
      lightboxCounter.textContent = `${currentIndex + 1} / ${activeItems.length}`;
    }

    function prevImage() {
      if (activeItems.length <= 1) return;
      currentIndex = (currentIndex - 1 + activeItems.length) % activeItems.length;
      updateLightboxContent();
    }

    function nextImage() {
      if (activeItems.length <= 1) return;
      currentIndex = (currentIndex + 1) % activeItems.length;
      updateLightboxContent();
    }

    // Attach click triggers to cards
    galleryItems.forEach(item => {
      const card = item.querySelector('.jotar-gallery-card');
      if (card) {
        card.addEventListener('click', (e) => {
          openLightbox(item);
        });
      }
    });

    // Lightbox Controls
    if (prevBtn) prevBtn.addEventListener('click', (e) => { e.stopPropagation(); prevImage(); });
    if (nextBtn) nextBtn.addEventListener('click', (e) => { e.stopPropagation(); nextImage(); });
    
    closeTriggers.forEach(trigger => {
      trigger.addEventListener('click', closeLightbox);
    });

    // Keyboard navigation
    document.addEventListener('keydown', (e) => {
      if (!lightbox.classList.contains('is-open')) return;
      if (e.key === 'Escape') closeLightbox();
      if (e.key === 'ArrowLeft') prevImage();
      if (e.key === 'ArrowRight') nextImage();
    });
  });
</script>

