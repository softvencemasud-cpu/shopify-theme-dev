  <!-- 5. INTERACTIVE FULLSCREEN LIGHTBOX MODAL -->
  <div class="jotar-lightbox" id="jotar-lightbox-{{ section.id }}" aria-hidden="true" role="dialog" aria-modal="true">
    <div class="jotar-lightbox__backdrop" data-close-lightbox></div>
    
    <div class="jotar-lightbox__container">
      <button type="button" class="jotar-lightbox__close" aria-label="Close lightbox" data-close-lightbox>
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>

      <button type="button" class="jotar-lightbox__nav jotar-lightbox__nav--prev" aria-label="Previous image" id="jotar-lightbox-prev">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="15 18 9 12 15 6"></polyline>
        </svg>
      </button>

      <div class="jotar-lightbox__stage">
        <div class="jotar-lightbox__image-wrap">
          <img src="" alt="" class="jotar-lightbox__img" id="jotar-lightbox-img">
        </div>
        <div class="jotar-lightbox__caption">
          <div class="jotar-lightbox__meta">
            <span class="jotar-lightbox__tag" id="jotar-lightbox-tag">Lifestyle</span>
            <h3 class="jotar-lightbox__title" id="jotar-lightbox-title">NOVA Style</h3>
          </div>
          <div class="jotar-lightbox__counter" id="jotar-lightbox-counter">1 / 10</div>
        </div>
      </div>

