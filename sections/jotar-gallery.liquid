                  <span class="jotar-gallery-card__badge">Street</span>
                </div>
              </div>
              <button
                type="button"
                class="jotar-gallery-card__zoom-btn is-visible"
                aria-label="Expand image"
                data-zoom-src="{{ 'jotar-gallery-01.jpg' | asset_url }}"
