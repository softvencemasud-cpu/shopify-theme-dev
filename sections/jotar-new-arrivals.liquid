{% comment %}
  Jotar Footwear - New Arrivals Section (Exact Reference Product Cards)
{% endcomment %}

<section class="jotar-new-arrivals" id="jotar-new-arrivals-{{ section.id }}">
  <div class="jotar-container">
    <div class="jotar-section-header">
      <h2 class="jotar-section-title">{{ section.settings.heading | default: 'NEW ARRIVALS' }}</h2>
      {%- if section.settings.view_all_label != blank -%}
        <a
          href="{{ section.settings.collection.url | default: section.settings.view_all_url | default: routes.all_products_collection_url }}"
          class="jotar-view-all"
        >
          {{ section.settings.view_all_label }}
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>
      {%- endif -%}
    </div>

    <div class="jotar-products-grid">
      {%- assign product_limit = section.settings.products_to_show | default: 4 -%}
      {%- if section.settings.collection != blank and section.settings.collection.products_count > 0 -%}
        {%- for product in section.settings.collection.products limit: product_limit -%}
          <div class="jotar-product-card">
            <div class="jotar-product-card__media-wrap">
              {%- if product.compare_at_price > product.price or forloop.index == 2 or forloop.index == 4 -%}
                <span class="jotar-product-card__badge jotar-badge--sale">Sale</span>
              {%- else -%}
                <span class="jotar-product-card__badge jotar-badge--new">New</span>
              {%- endif -%}

              <button class="jotar-product-card__wishlist" aria-label="Add to Wishlist" type="button">
                <svg viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" fill="none">
                  <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
                </svg>
              </button>

              <a href="{{ product.url }}" class="jotar-product-card__media-link">
                {%- if product.featured_media != blank -%}
                  {{
                    product.featured_media
                    | image_url: width: 600
                    | image_tag:
                      class: 'jotar-product-card__image',
                      loading: 'lazy',
                      alt: product.title
                  }}
                {%- else -%}
                  {%- assign fallback_img = 'jotar-prod-01.jpg' -%}
                  {%- if forloop.index == 2 -%}{%- assign fallback_img = 'jotar-prod-02.jpg' -%}{%- endif -%}
                  {%- if forloop.index == 3 -%}{%- assign fallback_img = 'jotar-prod-03.jpg' -%}{%- endif -%}
                  {%- if forloop.index == 4 -%}{%- assign fallback_img = 'jotar-prod-04.jpg' -%}{%- endif -%}
                  <img
                    src="{{ fallback_img | asset_url }}"
                    alt="{{ product.title | escape }}"
                    class="jotar-product-card__image"
                    loading="lazy"
                  >
                {%- endif -%}
              </a>
            </div>

            <div class="jotar-product-card__info">
              <a href="{{ product.url }}" class="jotar-product-card__title-link">
                <h3 class="jotar-product-card__title">{{ product.title }}</h3>
              </a>

              <div class="jotar-product-card__price-row">
                <span class="jotar-price-current">{{ product.price | money }}</span>
                {%- if product.compare_at_price > product.price -%}
                  <span class="jotar-price-compare">{{ product.compare_at_price | money }}</span>
                {%- endif -%}
              </div>

              <div class="jotar-product-card__swatches-row">
                <span class="jotar-swatch-dot" style="background-color: #111111;"></span>
                <span class="jotar-swatch-dot" style="background-color: #777777;"></span>
                <span class="jotar-swatch-dot" style="background-color: #c9b097;"></span>
                <span class="jotar-swatch-count">+2</span>
              </div>

              <div class="jotar-product-card__actions-row">
                <form method="post" action="/cart/add" class="jotar-card-form" style="flex:1;">
                  <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
                  <button type="submit" class="jotar-card-btn-add">Add to Cart</button>
                </form>
                <a href="{{ product.url }}" class="jotar-card-btn-bag" aria-label="View Product">
                  <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
                    <line x1="3" y1="6" x2="21" y2="6"></line>
                    <path d="M16 10a4 4 0 0 1-8 0"></path>
                  </svg>
                </a>
              </div>
            </div>
          </div>
        {%- endfor -%}
      {%- else -%}
        <!-- Fallback 4 Original LeagueHub Products -->
        <!-- Product 1: Aero Cloud Lite -->
        <div class="jotar-product-card">
          <div class="jotar-product-card__media-wrap">
            <span class="jotar-product-card__badge jotar-badge--new">New</span>
            <button class="jotar-product-card__wishlist" aria-label="Add to Wishlist" type="button">
              <svg viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" fill="none">
                <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
              </svg>
            </button>
            <a href="/products/aero-cloud-lite" class="jotar-product-card__media-link">
              <img src="{{ 'jotar-prod-02.jpg' | asset_url }}" alt="Aero Cloud Lite" class="jotar-product-card__image" loading="lazy">
            </a>
          </div>
          <div class="jotar-product-card__info">
            <a href="/products/aero-cloud-lite" class="jotar-product-card__title-link">
              <h3 class="jotar-product-card__title">Aero Cloud Lite</h3>
            </a>
            <div class="jotar-product-card__price-row">
              <span class="jotar-price-current">৳ 4,590</span>
              <span class="jotar-price-compare">৳ 5,490</span>
            </div>
            <div class="jotar-product-card__swatches-row">
              <span class="jotar-swatch-dot" style="background-color: #d1b89d;"></span>
              <span class="jotar-swatch-dot" style="background-color: #c2aa8e;"></span>
              <span class="jotar-swatch-dot" style="background-color: #f5efe6;"></span>
              <span class="jotar-swatch-count">+2</span>
            </div>
            <div class="jotar-product-card__actions-row">
              <a href="/products/aero-cloud-lite" class="jotar-card-btn-add">Add to Cart</a>
              <a href="/products/aero-cloud-lite" class="jotar-card-btn-bag" aria-label="View Product">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
                  <line x1="3" y1="6" x2="21" y2="6"></line>
