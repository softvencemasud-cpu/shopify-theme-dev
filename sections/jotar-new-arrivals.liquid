{% comment %}
  Jotar Footwear - New Arrivals Section
{% endcomment %}

<section class="jotar-new-arrivals" id="jotar-new-arrivals-{{ section.id }}">
  <div class="jotar-container">
    <div class="jotar-section-header">
      <h2 class="jotar-section-title">{{ section.settings.heading | default: 'NEW ARRIVALS' }}</h2>
      {%- if section.settings.view_all_label != blank -%}
        <a
          href="{{ section.settings.collection.url | default: section.settings.view_all_url | default: routes.all_products_collection_url }}"
          class="jotar-view-all"
        >
          {{ section.settings.view_all_label }}
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>
      {%- endif -%}
    </div>

    <div class="jotar-products-grid">
      {%- assign product_limit = section.settings.products_to_show | default: 4 -%}
      {%- if section.settings.collection != blank and section.settings.collection.products_count > 0 -%}
        {%- for product in section.settings.collection.products limit: product_limit -%}
          <div class="jotar-product-card">
            <div class="jotar-product-card__media-wrap">
              {%- if section.settings.show_badge -%}
                <span class="jotar-product-card__badge">New</span>
              {%- endif -%}

              {%- if section.settings.show_wishlist -%}
                <button class="jotar-product-card__wishlist" aria-label="Add to Wishlist">
                  <svg viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" fill="none">
                    <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
                  </svg>
                </button>
              {%- endif -%}

              <a href="{{ product.url }}" style="display:contents;">
                {%- if product.featured_media != blank -%}
                  {{
                    product.featured_media
                    | image_url: width: 600
                    | image_tag:
                      class: 'jotar-product-card__image',
                      loading: 'lazy',
                      alt: product.title
                  }}
                {%- else -%}
                  {%- assign fallback_img = 'jotar-prod-01.jpg' -%}
                  {%- if forloop.index == 2 -%}{%- assign fallback_img = 'jotar-prod-02.jpg' -%}{%- endif -%}
                  {%- if forloop.index == 3 -%}{%- assign fallback_img = 'jotar-prod-03.jpg' -%}{%- endif -%}
                  {%- if forloop.index == 4 -%}{%- assign fallback_img = 'jotar-prod-04.jpg' -%}{%- endif -%}
                  <img
                    src="{{ fallback_img | asset_url }}"
                    alt="{{ product.title | escape }}"
                    class="jotar-product-card__image"
                    loading="lazy"
                  >
                {%- endif -%}
              </a>
            </div>

            <a href="{{ product.url }}" style="text-decoration:none; color:inherit;">
              <h3 class="jotar-product-card__title">{{ product.title }}</h3>
            </a>

            <div class="jotar-product-card__price">
              {{ product.price | money }}
            </div>

            {%- if section.settings.show_swatches -%}
              <div class="jotar-product-card__swatches">
                <span class="jotar-swatch-dot" style="background-color: #111111;"></span>
                <span class="jotar-swatch-dot" style="background-color: #9e9e9e;"></span>
                <span class="jotar-swatch-dot" style="background-color: #e5e5e5;"></span>
              </div>
            {%- endif -%}

            {%- if section.settings.show_rating -%}
              <div class="jotar-product-card__rating">
                <span class="jotar-stars">★★★★★</span>
                <span>(120)</span>
              </div>
            {%- endif -%}
          </div>
        {%- endfor -%}
      {%- else -%}
        <!-- Fallback 4 Original LeagueHub Products -->
        <!-- Product 1: Urban Pulse Runner -->
        <div class="jotar-product-card">
          <div class="jotar-product-card__media-wrap">
            <span class="jotar-product-card__badge">New</span>
            <button class="jotar-product-card__wishlist" aria-label="Add to Wishlist">
              <svg viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" fill="none">
                <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
              </svg>
            </button>
            <a href="/products/urban-pulse-runner" style="display:contents;">
              <img src="{{ 'jotar-prod-01.jpg' | asset_url }}" alt="Urban Pulse Runner" class="jotar-product-card__image" loading="lazy">
            </a>
          </div>
          <a href="/products/urban-pulse-runner" style="text-decoration:none; color:inherit;">
            <h3 class="jotar-product-card__title">Urban Pulse Runner</h3>
          </a>
          <div class="jotar-product-card__price">৳ 4,990</div>
          <div class="jotar-product-card__swatches">
            <span class="jotar-swatch-dot" style="background-color: #111111;"></span>
            <span class="jotar-swatch-dot" style="background-color: #777777;"></span>
            <span class="jotar-swatch-dot" style="background-color: #f0f0f0;"></span>
          </div>
          <div class="jotar-product-card__rating">
            <span class="jotar-stars">★★★★★</span>
            <span>(120)</span>
          </div>
        </div>

        <!-- Product 2: Aero Cloud Lite -->
        <div class="jotar-product-card">
          <div class="jotar-product-card__media-wrap">
            <span class="jotar-product-card__badge">New</span>
            <button class="jotar-product-card__wishlist" aria-label="Add to Wishlist">
              <svg viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" fill="none">
                <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
              </svg>
            </button>
            <a href="/products/aero-cloud-lite" style="display:contents;">
              <img src="{{ 'jotar-prod-02.jpg' | asset_url }}" alt="Aero Cloud Lite" class="jotar-product-card__image" loading="lazy">
            </a>
          </div>
          <a href="/products/aero-cloud-lite" style="text-decoration:none; color:inherit;">
            <h3 class="jotar-product-card__title">Aero Cloud Lite</h3>
          </a>
          <div class="jotar-product-card__price">৳ 4,590</div>
          <div class="jotar-product-card__swatches">
            <span class="jotar-swatch-dot" style="background-color: #d4c5b3;"></span>
            <span class="jotar-swatch-dot" style="background-color: #333333;"></span>
            <span class="jotar-swatch-dot" style="background-color: #ffffff;"></span>
          </div>
          <div class="jotar-product-card__rating">
            <span class="jotar-stars">★★★★★</span>
            <span>(95)</span>
          </div>
        </div>

        <!-- Product 3: Terra Drift -->
        <div class="jotar-product-card">
          <div class="jotar-product-card__media-wrap">
            <span class="jotar-product-card__badge">New</span>
            <button class="jotar-product-card__wishlist" aria-label="Add to Wishlist">
              <svg viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" fill="none">
                <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
              </svg>
            </button>
            <a href="/products/terra-drift" style="display:contents;">
              <img src="{{ 'jotar-prod-03.jpg' | asset_url }}" alt="Terra Drift" class="jotar-product-card__image" loading="lazy">
            </a>
          </div>
          <a href="/products/terra-drift" style="text-decoration:none; color:inherit;">
            <h3 class="jotar-product-card__title">Terra Drift</h3>
          </a>
          <div class="jotar-product-card__price">৳ 4,290</div>
          <div class="jotar-product-card__swatches">
            <span class="jotar-swatch-dot" style="background-color: #ffffff;"></span>
            <span class="jotar-swatch-dot" style="background-color: #111111;"></span>
            <span class="jotar-swatch-dot" style="background-color: #1565c0;"></span>
          </div>
          <div class="jotar-product-card__rating">
            <span class="jotar-stars">★★★★★</span>
            <span>(74)</span>
          </div>
        </div>

        <!-- Product 4: Shadow Flex Pro -->
        <div class="jotar-product-card">
          <div class="jotar-product-card__media-wrap">
            <span class="jotar-product-card__badge">New</span>
            <button class="jotar-product-card__wishlist" aria-label="Add to Wishlist">
              <svg viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" fill="none">
                <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
              </svg>
            </button>
            <a href="/products/shadow-flex-pro" style="display:contents;">
              <img src="{{ 'jotar-prod-04.jpg' | asset_url }}" alt="Shadow Flex Pro" class="jotar-product-card__image" loading="lazy">
            </a>
          </div>
          <a href="/products/shadow-flex-pro" style="text-decoration:none; color:inherit;">
            <h3 class="jotar-product-card__title">Shadow Flex Pro</h3>
          </a>
          <div class="jotar-product-card__price">৳ 5,490</div>
          <div class="jotar-product-card__swatches">
            <span class="jotar-swatch-dot" style="background-color: #111111;"></span>
            <span class="jotar-swatch-dot" style="background-color: #3e2723;"></span>
            <span class="jotar-swatch-dot" style="background-color: #ffffff;"></span>
          </div>
          <div class="jotar-product-card__rating">
            <span class="jotar-stars">★★★★★</span>
            <span>(58)</span>
          </div>
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "New Arrivals",
  "tag": "section",
  "class": "section-jotar-new-arrivals",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section Heading",
      "default": "NEW ARRIVALS"
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "View All Label",
      "default": "VIEW ALL"
    },
    {
      "type": "url",
      "id": "view_all_url",
      "label": "View All Link"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Select Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 4,
      "label": "Products to Show"
    },
    {
      "type": "checkbox",
      "id": "show_badge",
      "label": "Show 'New' Badge",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_wishlist",
      "label": "Show Wishlist Heart",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_swatches",
      "label": "Show Color Swatches",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "label": "Show Star Rating",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "New Arrivals"
    }
  ]
}
{% endschema %}
