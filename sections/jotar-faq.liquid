<script>
  document.addEventListener('DOMContentLoaded', function() {
    const root = document.getElementById('jotar-faq-{{ section.id }}');
    if (!root) return;

    const catButtons = root.querySelectorAll('.jotar-faq-cat-btn');
    const faqItems = root.querySelectorAll('.jotar-faq-item');
    const searchInput = document.getElementById('jotar-faq-search-input');
    const searchClear = document.getElementById('jotar-faq-search-clear');
    const searchCount = document.getElementById('jotar-faq-search-count');
    const emptyState = document.getElementById('jotar-faq-empty');
    const resetBtn = document.getElementById('jotar-faq-reset-btn');

    let currentCategory = 'all';

    // 1. Accordion Toggle
    faqItems.forEach(item => {
      const trigger = item.querySelector('.jotar-faq-trigger');
      const content = item.querySelector('.jotar-faq-content');

      trigger.addEventListener('click', () => {
        const isOpen = item.classList.contains('is-open');

        // Close other items in smooth single-accordion mode
        faqItems.forEach(other => {
          if (other !== item) {
            other.classList.remove('is-open');
            other.querySelector('.jotar-faq-trigger').setAttribute('aria-expanded', 'false');
            other.querySelector('.jotar-faq-content').style.maxHeight = null;
          }
        });

        if (isOpen) {
          item.classList.remove('is-open');
          trigger.setAttribute('aria-expanded', 'false');
          content.style.maxHeight = null;
        } else {
          item.classList.add('is-open');
          trigger.setAttribute('aria-expanded', 'true');
          content.style.maxHeight = content.scrollHeight + 50 + 'px';
        }
      });
    });

    // 2. Filter & Search Combined Logic
    function applyFilterAndSearch() {
      const query = (searchInput ? searchInput.value : '').toLowerCase().trim();
      let visibleCount = 0;

      faqItems.forEach(item => {
        const itemCat = item.getAttribute('data-category');
        const question = item.querySelector('.jotar-faq-question').textContent.toLowerCase();
        const answer = item.querySelector('.jotar-faq-answer').textContent.toLowerCase();

        const matchesCategory = currentCategory === 'all' || itemCat === currentCategory;
        const matchesSearch = !query || question.includes(query) || answer.includes(query);

        if (matchesCategory && matchesSearch) {
          item.classList.remove('is-hidden');
          visibleCount++;
        } else {
          item.classList.add('is-hidden');
        }
      });

      // Update Search Count & Empty state
      if (searchCount) {
        if (query) {
          searchCount.style.display = 'block';
          searchCount.textContent = `Found ${visibleCount} result${visibleCount === 1 ? '' : 's'} for "${query}"`;
        } else {
          searchCount.style.display = 'none';
        }
      }

      if (emptyState) {
        emptyState.style.display = visibleCount === 0 ? 'block' : 'none';
      }
    }

    // 3. Category Buttons
    catButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        catButtons.forEach(b => {
          b.classList.remove('is-active');
          b.setAttribute('aria-selected', 'false');
        });
        btn.classList.add('is-active');
        btn.setAttribute('aria-selected', 'true');

        currentCategory = btn.getAttribute('data-category');
        applyFilterAndSearch();
      });
    });

    // 4. Live Search Handler
    if (searchInput) {
      searchInput.addEventListener('input', () => {
        if (searchInput.value.trim().length > 0) {
          searchClear.classList.add('is-visible');
        } else {
          searchClear.classList.remove('is-visible');
        }
        applyFilterAndSearch();
      });

      if (searchClear) {
        searchClear.addEventListener('click', () => {
          searchInput.value = '';
          searchClear.classList.remove('is-visible');
          applyFilterAndSearch();
          searchInput.focus();
        });
      }
    }

    if (resetBtn) {
      resetBtn.addEventListener('click', () => {
        if (searchInput) searchInput.value = '';
        if (searchClear) searchClear.classList.remove('is-visible');
        const allBtn = root.querySelector('.jotar-faq-cat-btn[data-category="all"]');
        if (allBtn) allBtn.click();
      });
    }
  });
</script>

