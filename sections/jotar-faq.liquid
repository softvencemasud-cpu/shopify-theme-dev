{% comment %}
  Jotar / NOVA - Premium FAQ (Help & Support) Section
  Unified, perfectly aligned container width for all elements (Breadcrumb, Header, Search, Categories, Accordions, Contact Card).
{% endcomment %}

<div class="jotar-faq" id="jotar-faq-{{ section.id }}">
  <div class="jotar-faq-container">
    <!-- 1. BREADCRUMBS -->
    {%- if section.settings.show_breadcrumbs -%}
      <div class="jotar-faq-breadcrumbs-wrap">
        <nav class="jotar-faq-breadcrumbs" aria-label="Breadcrumb">
          <a href="{{ routes.root_url }}">Home</a>
          <span class="jotar-faq-breadcrumbs__sep" aria-hidden="true">&rsaquo;</span>
          <span class="jotar-faq-breadcrumbs__current">{{ section.settings.breadcrumb_title | default: 'FAQ' }}</span>
        </nav>
      </div>
    {%- endif -%}

    <!-- 2. HERO HEADER & SEARCH BAR -->
    <section class="jotar-faq-hero">
      <div class="jotar-faq-hero__content">
        <span class="jotar-faq-eyebrow">{{ section.settings.eyebrow | default: 'HELP & SUPPORT' }}</span>
        <h1 class="jotar-faq-hero__title">{{ section.settings.heading | default: 'FREQUENTLY ASKED QUESTIONS' }}</h1>
        <p class="jotar-faq-hero__desc">
          {{ section.settings.subtext | default: 'Everything you need to know about our footwear, ordering, sizing, shipping, and returns.' }}
        </p>

        <!-- Live Instant Search Box -->
        {%- if section.settings.show_search -%}
          <div class="jotar-faq-search">
            <div class="jotar-faq-search__wrapper">
              <svg class="jotar-faq-search__icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="11" cy="11" r="8"></circle>
                <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
              </svg>
              <input
                type="text"
                id="jotar-faq-search-input"
                class="jotar-faq-search__input"
                placeholder="Search by keyword (e.g., sizing, return policy, delivery)..."
                aria-label="Search frequently asked questions"
                autocomplete="off"
              >
              <button type="button" class="jotar-faq-search__clear" id="jotar-faq-search-clear" aria-label="Clear search">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <line x1="18" y1="6" x2="6" y2="18"></line>
                  <line x1="6" y1="6" x2="18" y2="18"></line>
                </svg>
              </button>
            </div>
            <div class="jotar-faq-search__results-count" id="jotar-faq-search-count" style="display: none;"></div>
          </div>
        {%- endif -%}
      </div>
    </section>

    <!-- 3. CATEGORY TABS -->
    <div class="jotar-faq-categories-section">
      <div class="jotar-faq-categories" role="tablist" aria-label="FAQ Categories">
        <button type="button" class="jotar-faq-cat-btn is-active" data-category="all" role="tab" aria-selected="true">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="3" width="7" height="7"></rect>
            <rect x="14" y="3" width="7" height="7"></rect>
            <rect x="14" y="14" width="7" height="7"></rect>
            <rect x="3" y="14" width="7" height="7"></rect>
          </svg>
          <span>All Questions</span>
        </button>

        <button type="button" class="jotar-faq-cat-btn" data-category="sizing" role="tab" aria-selected="false">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
          </svg>
          <span>Sizing & Fit</span>
        </button>

        <button type="button" class="jotar-faq-cat-btn" data-category="shipping" role="tab" aria-selected="false">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="1" y="3" width="15" height="13"></rect>
            <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon>
            <circle cx="5.5" cy="18.5" r="2.5"></circle>
            <circle cx="18.5" cy="18.5" r="2.5"></circle>
          </svg>
          <span>Shipping & Delivery</span>
        </button>

        <button type="button" class="jotar-faq-cat-btn" data-category="returns" role="tab" aria-selected="false">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="1 4 1 10 7 10"></polyline>
            <path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"></path>
          </svg>
          <span>Returns & Exchanges</span>
        </button>

        <button type="button" class="jotar-faq-cat-btn" data-category="orders" role="tab" aria-selected="false">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="1" y="4" width="22" height="16" rx="2" ry="2"></rect>
            <line x1="1" y1="10" x2="23" y2="10"></line>
          </svg>
          <span>Orders & Payment</span>
        </button>

        <button type="button" class="jotar-faq-cat-btn" data-category="care" role="tab" aria-selected="false">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z"></path>
          </svg>
          <span>Care & Cleaning</span>
        </button>
      </div>
    </div>

    <!-- 4. FAQ ACCORDION LIST -->
    <section class="jotar-faq-main-section">
      <div class="jotar-faq-accordion-list" id="jotar-faq-list">
        {%- if section.blocks.size > 0 -%}
          {%- for block in section.blocks -%}
            {%- assign block_cat = block.settings.category | default: 'sizing' | downcase -%}
            <div
              class="jotar-faq-item"
              data-category="{{ block_cat }}"
              {{ block.shopify_attributes }}
            >
              <button
                type="button"
                class="jotar-faq-trigger"
                aria-expanded="{% if forloop.first %}true{% else %}false{% endif %}"
              >
                <span class="jotar-faq-question">{{ block.settings.question }}</span>
                <span class="jotar-faq-icon-wrap" aria-hidden="true">
                  <svg class="jotar-faq-chevron" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="6 9 12 15 18 9"></polyline>
                  </svg>
                </span>
              </button>
              <div class="jotar-faq-content" {% if forloop.first %}style="max-height: 500px;"{% endif %}>
                <div class="jotar-faq-answer">
                  {{ block.settings.answer }}
                </div>
              </div>
            </div>
          {%- endfor -%}
        {%- else -%}
          <!-- DEFAULT RICH FAQS IF NO BLOCKS ADDED YET -->

          <!-- 1. Sizing -->
          <div class="jotar-faq-item is-open" data-category="sizing">
            <button type="button" class="jotar-faq-trigger" aria-expanded="true">
              <span class="jotar-faq-question">How do NOVA sneakers fit? Are they true to size?</span>
              <span class="jotar-faq-icon-wrap" aria-hidden="true">
                <svg class="jotar-faq-chevron" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="6 9 12 15 18 9"></polyline>
                </svg>
              </span>
            </button>
            <div class="jotar-faq-content" style="max-height: 500px;">
              <div class="jotar-faq-answer">
                <p>All NOVA sneakers are engineered to fit true to standard US/EU sizing. If you typically wear a half size or have wider feet, we recommend ordering half a size up for maximum comfort during all-day wear and athletic activities.</p>
              </div>
            </div>
          </div>

          <div class="jotar-faq-item" data-category="sizing">
            <button type="button" class="jotar-faq-trigger" aria-expanded="false">
              <span class="jotar-faq-question">Where can I find the official shoe size conversion chart?</span>
              <span class="jotar-faq-icon-wrap" aria-hidden="true">
                <svg class="jotar-faq-chevron" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="6 9 12 15 18 9"></polyline>
                </svg>
              </span>
            </button>
            <div class="jotar-faq-content">
              <div class="jotar-faq-answer">
                <p>Every product page includes a <strong>"Size Guide"</strong> button right above the size selector. It displays comprehensive measurements in US, UK, EU, and CM to help you find your exact fit with precision.</p>
              </div>
            </div>
          </div>

          <!-- 2. Shipping -->
          <div class="jotar-faq-item" data-category="shipping">
            <button type="button" class="jotar-faq-trigger" aria-expanded="false">
              <span class="jotar-faq-question">What are your delivery options and shipping times?</span>
              <span class="jotar-faq-icon-wrap" aria-hidden="true">
                <svg class="jotar-faq-chevron" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="6 9 12 15 18 9"></polyline>
                </svg>
              </span>
            </button>
            <div class="jotar-faq-content">
              <div class="jotar-faq-answer">
                <p>We offer two shipping methods on all orders:</p>
                <ul>
                  <li><strong>Standard Shipping:</strong> 3–5 business days (Free on orders over $100).</li>
                  <li><strong>Express Courier:</strong> 1–2 business days with priority fulfillment.</li>
                </ul>
                <p>Orders placed before 2:00 PM EST are dispatched on the very same business day.</p>
              </div>
            </div>
          </div>

          <div class="jotar-faq-item" data-category="shipping">
            <button type="button" class="jotar-faq-trigger" aria-expanded="false">
              <span class="jotar-faq-question">Do you offer international shipping outside the United States?</span>
              <span class="jotar-faq-icon-wrap" aria-hidden="true">
                <svg class="jotar-faq-chevron" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="6 9 12 15 18 9"></polyline>
                </svg>
              </span>
            </button>
            <div class="jotar-faq-content">
              <div class="jotar-faq-answer">
                <p>Yes, we ship to over 60 countries worldwide via DHL Express. All international customs duties, import taxes, and courier fees are calculated transparently at checkout with no surprise fees on delivery.</p>
              </div>
            </div>
          </div>

          <!-- 3. Returns -->
          <div class="jotar-faq-item" data-category="returns">
            <button type="button" class="jotar-faq-trigger" aria-expanded="false">
              <span class="jotar-faq-question">What is your return & exchange policy?</span>
              <span class="jotar-faq-icon-wrap" aria-hidden="true">
                <svg class="jotar-faq-chevron" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="6 9 12 15 18 9"></polyline>
                </svg>
              </span>
            </button>
            <div class="jotar-faq-content">
              <div class="jotar-faq-answer">
                <p>We want you to love your shoes! We offer a <strong>30-day hassle-free return and exchange guarantee</strong> from the date of delivery. Items must be unworn, in original brand packaging with all tags attached.</p>
              </div>
            </div>
          </div>

          <div class="jotar-faq-item" data-category="returns">
            <button type="button" class="jotar-faq-trigger" aria-expanded="false">
              <span class="jotar-faq-question">How do I initiate a return or swap for another size?</span>
              <span class="jotar-faq-icon-wrap" aria-hidden="true">
                <svg class="jotar-faq-chevron" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="6 9 12 15 18 9"></polyline>
                </svg>
              </span>
            </button>
            <div class="jotar-faq-content">
              <div class="jotar-faq-answer">
                <p>Simply contact our support team at <a href="mailto:support@novasneakers.com">support@novasneakers.com</a> with your order number. We will immediately issue a prepaid return shipping label and process your replacement or full refund upon receipt.</p>
              </div>
            </div>
          </div>

          <!-- 4. Orders & Payment -->
          <div class="jotar-faq-item" data-category="orders">
            <button type="button" class="jotar-faq-trigger" aria-expanded="false">
              <span class="jotar-faq-question">What payment methods do you accept?</span>
              <span class="jotar-faq-icon-wrap" aria-hidden="true">
                <svg class="jotar-faq-chevron" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="6 9 12 15 18 9"></polyline>
                </svg>
              </span>
            </button>
            <div class="jotar-faq-content">
              <div class="jotar-faq-answer">
                <p>We accept all major credit cards (Visa, Mastercard, American Express, Discover), PayPal, Apple Pay, Google Pay, and Shop Pay. We also offer buy-now-pay-later installments with 0% APR via Klarna & Afterpay.</p>
              </div>
            </div>
          </div>

          <div class="jotar-faq-item" data-category="orders">
            <button type="button" class="jotar-faq-trigger" aria-expanded="false">
              <span class="jotar-faq-question">Can I change or cancel my order after placing it?</span>
              <span class="jotar-faq-icon-wrap" aria-hidden="true">
                <svg class="jotar-faq-chevron" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="6 9 12 15 18 9"></polyline>
                </svg>
              </span>
            </button>
            <div class="jotar-faq-content">
              <div class="jotar-faq-answer">
                <p>If you need to make changes or cancel your order, please reach out to us within 1 hour of placing the order. Once our warehouse begins processing and packing, orders cannot be cancelled, but you can easily exchange or return upon delivery.</p>
              </div>
            </div>
          </div>

          <!-- 5. Care & Cleaning -->
          <div class="jotar-faq-item" data-category="care">
            <button type="button" class="jotar-faq-trigger" aria-expanded="false">
              <span class="jotar-faq-question">How should I clean and protect my NOVA sneakers?</span>
              <span class="jotar-faq-icon-wrap" aria-hidden="true">
                <svg class="jotar-faq-chevron" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="6 9 12 15 18 9"></polyline>
                </svg>
              </span>
            </button>
            <div class="jotar-faq-content">
              <div class="jotar-faq-answer">
                <p>For everyday cleaning, use a soft bristle brush or microfiber cloth with lukewarm water and mild sneaker cleanser. Air dry naturally at room temperature away from direct sunlight. Never put sneakers in a washing machine or tumble dryer to protect the structural integrity of the midsole.</p>
              </div>
            </div>
          </div>

          <div class="jotar-faq-item" data-category="care">
            <button type="button" class="jotar-faq-trigger" aria-expanded="false">
              <span class="jotar-faq-question">Are NOVA sneakers waterproof or water-resistant?</span>
              <span class="jotar-faq-icon-wrap" aria-hidden="true">
                <svg class="jotar-faq-chevron" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="6 9 12 15 18 9"></polyline>
                </svg>
              </span>
            </button>
            <div class="jotar-faq-content">
              <div class="jotar-faq-answer">
                <p>Our engineered mesh and leather models feature water-repellent coatings designed to withstand light rain and splashes. For full storm protection, check out our All-Weather editions with sealed waterproof inner membranes.</p>
              </div>
            </div>
          </div>
        {%- endif -%}
      </div>

      <!-- Empty Search Fallback State -->
      <div class="jotar-faq-empty-state" id="jotar-faq-empty" style="display: none;">
        <div class="jotar-faq-empty-icon">
          <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            <line x1="8" y1="11" x2="14" y2="11"></line>
          </svg>
        </div>
        <h3>No matching questions found</h3>
        <p>Try searching for a different keyword or browse questions by category above.</p>
        <button type="button" class="jotar-faq-empty-btn" id="jotar-faq-reset-btn">View All Questions</button>
      </div>
    </section>

    <!-- 5. "STILL HAVE QUESTIONS?" SUPPORT CARD -->
    {%- if section.settings.show_contact_card -%}
      <section class="jotar-faq-contact-section">
        <div class="jotar-faq-contact-card">
          <div class="jotar-faq-contact-header">
            <span class="jotar-faq-contact-badge">GET IN TOUCH</span>
            <h2 class="jotar-faq-contact-title">{{ section.settings.contact_title | default: 'Still have questions?' }}</h2>
            <p class="jotar-faq-contact-desc">
              {{ section.settings.contact_desc | default: "Can't find what you're looking for? Our friendly support team is here to help you every step of the way." }}
            </p>
          </div>

          <div class="jotar-faq-contact-methods">
            <!-- Method 1: Email Support -->
            <a href="mailto:{{ section.settings.contact_email | default: 'support@novasneakers.com' }}" class="jotar-faq-contact-box">
              <div class="jotar-faq-contact-box__icon">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="2" y="4" width="20" height="16" rx="2"></rect>
                  <path d="M22 7l-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
                </svg>
              </div>
              <div class="jotar-faq-contact-box__info">
                <h4>Email Us</h4>
                <p>{{ section.settings.contact_email | default: 'support@novasneakers.com' }}</p>
                <span class="jotar-faq-contact-box__hint">Response in 24 hours</span>
              </div>
            </a>

            <!-- Method 2: Phone Support -->
            <a href="tel:{{ section.settings.contact_phone | default: '+15551234567' }}" class="jotar-faq-contact-box">
              <div class="jotar-faq-contact-box__icon">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
                </svg>
              </div>
              <div class="jotar-faq-contact-box__info">
                <h4>Call Support</h4>
                <p>{{ section.settings.contact_phone | default: '+1 (555) 123-4567' }}</p>
                <span class="jotar-faq-contact-box__hint">Mon–Fri: 9AM – 6PM</span>
              </div>
            </a>

            <!-- Method 3: Contact Page Link -->
            <a href="{{ section.settings.contact_page_url | default: '/pages/contact' }}" class="jotar-faq-contact-box">
              <div class="jotar-faq-contact-box__icon">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
                </svg>
              </div>
              <div class="jotar-faq-contact-box__info">
                <h4>Help Center</h4>
                <p>Send a Direct Message</p>
                <span class="jotar-faq-contact-box__hint">Submit online ticket</span>
              </div>
            </a>
          </div>
        </div>
      </section>
    {%- endif -%}
  </div>
</div>

<style>
  /* ==========================================================================
     JOTAR / NOVA FAQ SECTION STYLES - UNIFIED PERFECT ALIGNMENT
     ========================================================================== */
  .jotar-faq {
    --faq-bg: #ffffff;
    --faq-text-main: #111111;
    --faq-text-muted: #666666;
    --faq-card-bg: #fafafa;
    --faq-card-hover: #f3f3f5;
    --faq-border: #e8e8ed;
    --faq-accent: #111111;
    --faq-radius: 12px;
    background-color: var(--faq-bg);
    color: var(--faq-text-main);
    font-family: var(--font-body-family, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif);
    padding-bottom: 90px;
  }

  /* Unified width for ALL FAQ elements */
  .jotar-faq-container {
    width: 100%;
    max-width: 900px;
    margin: 0 auto;
    padding: 0 24px;
    box-sizing: border-box;
  }

  /* Breadcrumbs aligned directly with content */
  .jotar-faq-breadcrumbs-wrap {
    padding: 24px 0 16px;
  }

  .jotar-faq-breadcrumbs {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    color: var(--faq-text-muted);
  }

  .jotar-faq-breadcrumbs a {
    color: var(--faq-text-muted);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .jotar-faq-breadcrumbs a:hover {
    color: var(--faq-text-main);
  }

  .jotar-faq-breadcrumbs__sep {
    color: #aaaaaa;
  }

  .jotar-faq-breadcrumbs__current {
    color: var(--faq-text-main);
    font-weight: 500;
  }

  /* Hero Section */
  .jotar-faq-hero {
    padding: 10px 0 32px;
    text-align: center;
