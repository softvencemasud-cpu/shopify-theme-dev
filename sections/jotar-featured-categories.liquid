{% comment %}
  Jotar Footwear - Featured Categories Section
{% endcomment %}

<section class="jotar-categories" id="jotar-categories-{{ section.id }}">
  <div class="jotar-container">
    {%- if section.settings.heading != blank -%}
      <div class="jotar-section-header jotar-section-header--center">
        <h2 class="jotar-section-title">{{ section.settings.heading }}</h2>
      </div>
    {%- endif -%}

    <div class="jotar-categories__grid">
      {%- if section.blocks.size > 0 -%}
        {%- for block in section.blocks -%}
          <a
            href="{{ block.settings.link | default: routes.all_products_collection_url }}"
            class="jotar-category-card"
            style="background: {{ block.settings.card_bg | default: '#161616' }};"
            {{ block.shopify_attributes }}
          >
            <h3 class="jotar-category-card__title">{{ block.settings.title }}</h3>
            <div class="jotar-category-card__media">
              {%- if block.settings.image != blank -%}
                {{
                  block.settings.image
                  | image_url: width: 600
                  | image_tag:
                    class: 'jotar-category-card__image',
                    loading: 'lazy',
                    alt: block.settings.title
                }}
              {%- else -%}
                {%- case forloop.index -%}
                  {%- when 1 -%}
                    <img
                      src="{{ 'jotar-category-sneakers.jpg' | asset_url }}"
                      alt="Sneakers"
                      class="jotar-category-card__image"
                      loading="lazy"
                    >
                  {%- when 2 -%}
                    <img
                      src="{{ 'jotar-category-running.jpg' | asset_url }}"
                      alt="Running"
                      class="jotar-category-card__image"
                      loading="lazy"
                    >
                  {%- when 3 -%}
                    <img
                      src="{{ 'jotar-category-casual.jpg' | asset_url }}"
                      alt="Casual"
                      class="jotar-category-card__image"
                      loading="lazy"
                    >
                  {%- else -%}
                    <img
                      src="{{ 'jotar-category-premium.jpg' | asset_url }}"
                      alt="Premium"
                      class="jotar-category-card__image"
                      loading="lazy"
                    >
                {%- endcase -%}
              {%- endif -%}
            </div>
          </a>
        {%- endfor -%}
      {%- else -%}
        <!-- Default 4 Cards with Real Photographic Images -->
        <a href="{{ routes.all_products_collection_url }}" class="jotar-category-card" style="background: #181818;">
          <h3 class="jotar-category-card__title">SNEAKERS</h3>
          <div class="jotar-category-card__media">
            <img src="{{ 'jotar-category-sneakers.jpg' | asset_url }}" alt="Sneakers" class="jotar-category-card__image" loading="lazy">
          </div>
        </a>
        <a href="{{ routes.all_products_collection_url }}" class="jotar-category-card" style="background: #24292e;">
          <h3 class="jotar-category-card__title">RUNNING</h3>
          <div class="jotar-category-card__media">
            <img src="{{ 'jotar-category-running.jpg' | asset_url }}" alt="Running" class="jotar-category-card__image" loading="lazy">
          </div>
        </a>
        <a href="{{ routes.all_products_collection_url }}" class="jotar-category-card" style="background: #332f2c;">
          <h3 class="jotar-category-card__title">CASUAL</h3>
          <div class="jotar-category-card__media">
            <img src="{{ 'jotar-category-casual.jpg' | asset_url }}" alt="Casual" class="jotar-category-card__image" loading="lazy">
          </div>
        </a>
        <a href="{{ routes.all_products_collection_url }}" class="jotar-category-card" style="background: #191919;">
          <h3 class="jotar-category-card__title">PREMIUM</h3>
          <div class="jotar-category-card__media">
            <img src="{{ 'jotar-category-premium.jpg' | asset_url }}" alt="Premium" class="jotar-category-card__image" loading="lazy">
          </div>
        </a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Featured Categories",
  "tag": "section",
  "class": "section-jotar-categories",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section Heading",
      "default": "FEATURED CATEGORIES"
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category Card",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Category Title",
          "default": "SNEAKERS"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Category Sneaker Image"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Category Link"
        },
        {
          "type": "color",
          "id": "card_bg",
          "label": "Card Background Color",
          "default": "#181818"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Featured Categories",
      "blocks": [
        {
          "type": "category",
          "settings": {
            "title": "SNEAKERS",
            "card_bg": "#181818"
          }
        },
        {
          "type": "category",
          "settings": {
            "title": "RUNNING",
            "card_bg": "#24292e"
          }
        },
        {
          "type": "category",
          "settings": {
            "title": "CASUAL",
            "card_bg": "#332f2c"
          }
        },
        {
          "type": "category",
          "settings": {
            "title": "PREMIUM",
            "card_bg": "#191919"
          }
        }
      ]
    }
  ]
}
{% endschema %}
