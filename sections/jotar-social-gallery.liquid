{% comment %}
  Jotar Footwear - Instagram / Social Gallery Section
{% endcomment %}

<section class="jotar-social-gallery" id="jotar-social-{{ section.id }}">
  <div class="jotar-container">
    <div class="jotar-section-header">
      <h2 class="jotar-section-title">{{ section.settings.heading | default: 'FOLLOW OUR STYLE' }}</h2>
      {%- if section.settings.handle_label != blank -%}
        <a
          href="{{ section.settings.handle_url | default: 'https://instagram.com' }}"
          class="jotar-view-all"
          target="_blank"
          rel="noopener noreferrer"
        >
          {{ section.settings.handle_label }}
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>
      {%- endif -%}
    </div>

    <div class="jotar-social-gallery__grid">
      {%- if section.blocks.size > 0 -%}
        {%- for block in section.blocks -%}
          <a
            href="{{ block.settings.link | default: 'https://instagram.com' }}"
            class="jotar-social-card"
            target="_blank"
            rel="noopener noreferrer"
            {{ block.shopify_attributes }}
          >
            {%- if block.settings.image != blank -%}
              {{
                block.settings.image
                | image_url: width: 400
                | image_tag:
                  class: 'jotar-social-card__image',
                  loading: 'lazy',
                  alt: 'Social Style Look'
              }}
            {%- else -%}
              {%- assign social_img = 'jotar-social-01.jpg' -%}
              {%- if forloop.index == 2 -%}{%- assign social_img = 'jotar-social-02.jpg' -%}{%- endif -%}
              {%- if forloop.index == 3 -%}{%- assign social_img = 'jotar-social-03.jpg' -%}{%- endif -%}
              {%- if forloop.index == 4 -%}{%- assign social_img = 'jotar-social-04.jpg' -%}{%- endif -%}
              {%- if forloop.index == 5 -%}{%- assign social_img = 'jotar-social-05.jpg' -%}{%- endif -%}
              {%- if forloop.index == 6 -%}{%- assign social_img = 'jotar-social-06.jpg' -%}{%- endif -%}
              <img
                src="{{ social_img | asset_url }}"
                alt="Social Style Look"
                class="jotar-social-card__image"
                loading="lazy"
              >
            {%- endif -%}

            <div class="jotar-social-card__icon" aria-label="Instagram">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
                <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
                <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
              </svg>
            </div>
          </a>
        {%- endfor -%}
      {%- else -%}
        <!-- 6 Fallback Social Items with Real Photographic Images -->
        <a href="https://instagram.com" class="jotar-social-card" target="_blank" rel="noopener noreferrer">
          <img src="{{ 'jotar-social-01.jpg' | asset_url }}" alt="Social Look 1" class="jotar-social-card__image" loading="lazy">
          <div class="jotar-social-card__icon" aria-label="Instagram">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
              <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
              <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
            </svg>
          </div>
        </a>
        <a href="https://instagram.com" class="jotar-social-card" target="_blank" rel="noopener noreferrer">
          <img src="{{ 'jotar-social-02.jpg' | asset_url }}" alt="Social Look 2" class="jotar-social-card__image" loading="lazy">
          <div class="jotar-social-card__icon" aria-label="Instagram">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
              <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
              <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
            </svg>
          </div>
        </a>
        <a href="https://instagram.com" class="jotar-social-card" target="_blank" rel="noopener noreferrer">
          <img src="{{ 'jotar-social-03.jpg' | asset_url }}" alt="Social Look 3" class="jotar-social-card__image" loading="lazy">
          <div class="jotar-social-card__icon" aria-label="Instagram">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
              <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
              <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
            </svg>
          </div>
        </a>
        <a href="https://instagram.com" class="jotar-social-card" target="_blank" rel="noopener noreferrer">
          <img src="{{ 'jotar-social-04.jpg' | asset_url }}" alt="Social Look 4" class="jotar-social-card__image" loading="lazy">
          <div class="jotar-social-card__icon" aria-label="Instagram">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
              <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
              <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
            </svg>
          </div>
        </a>
        <a href="https://instagram.com" class="jotar-social-card" target="_blank" rel="noopener noreferrer">
          <img src="{{ 'jotar-social-05.jpg' | asset_url }}" alt="Social Look 5" class="jotar-social-card__image" loading="lazy">
          <div class="jotar-social-card__icon" aria-label="Instagram">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
              <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
              <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
            </svg>
          </div>
        </a>
        <a href="https://instagram.com" class="jotar-social-card" target="_blank" rel="noopener noreferrer">
          <img src="{{ 'jotar-social-06.jpg' | asset_url }}" alt="Social Look 6" class="jotar-social-card__image" loading="lazy">
          <div class="jotar-social-card__icon" aria-label="Instagram">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
              <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
              <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
            </svg>
          </div>
        </a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Social Gallery",
  "tag": "section",
  "class": "section-jotar-social-gallery",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section Heading",
      "default": "FOLLOW OUR STYLE"
    },
    {
      "type": "text",
      "id": "handle_label",
      "label": "Instagram Handle / Link Text",
      "default": "@jotar.footwear"
    },
    {
      "type": "url",
      "id": "handle_url",
      "label": "Instagram URL"
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Social Post",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Social Image"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Post Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Social Gallery",
      "blocks": [
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" }
      ]
    }
  ]
}
{% endschema %}
