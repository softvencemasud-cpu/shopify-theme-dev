{% comment %}
  Jotar / NOVA - Shipping & Returns Page Section
{% endcomment %}

<div class="jotar-page-wrap" id="jotar-shipping-{{ section.id }}">
  <div class="jotar-container">
    <!-- Breadcrumbs -->
    <div class="jotar-page-breadcrumbs">
      <a href="{{ routes.root_url }}">Home</a>
      <span class="jotar-page-breadcrumbs__sep">&rsaquo;</span>
      <span class="jotar-page-breadcrumbs__current">Shipping & Returns</span>
    </div>

    <!-- Hero -->
    <div class="jotar-shipping-hero">
      <span class="jotar-eyebrow">CUSTOMER SERVICE</span>
      <h1 class="jotar-page-title">SHIPPING & RETURNS</h1>
      <p class="jotar-page-subtitle">
        Fast delivery worldwide and a hassle-free 30-day return policy. Everything you need to know about getting your NOVA sneakers.
      </p>
    </div>

    <!-- 3 Quick Guarantees -->
    <div class="jotar-shipping-strip">
      <div class="jotar-strip-item">
        <span class="jotar-strip-icon">🚚</span>
        <div>
          <h4>Free US Shipping</h4>
          <p>On all orders over $100</p>
        </div>
      </div>
      <div class="jotar-strip-item">
        <span class="jotar-strip-icon">🔄</span>
        <div>
          <h4>30-Day Returns</h4>
          <p>Easy exchanges & full refunds</p>
        </div>
      </div>
      <div class="jotar-strip-item">
        <span class="jotar-strip-icon">🌐</span>
        <div>
          <h4>Global Tracking</h4>
          <p>Real-time delivery updates</p>
        </div>
      </div>
    </div>

    <!-- Detailed Shipping Section -->
    <div class="jotar-shipping-details">
      <div class="jotar-section-block">
        <h2>1. Shipping Rates & Timelines</h2>
        <div class="jotar-table-responsive">
          <table class="jotar-custom-table">
            <thead>
              <tr>
                <th>Shipping Method</th>
                <th>Estimated Delivery</th>
                <th>Cost</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td><strong>Standard Shipping</strong></td>
                <td>3 – 5 Business Days</td>
                <td>Free over $100 (or $7.95)</td>
              </tr>
              <tr>
                <td><strong>Express Priority</strong></td>
                <td>1 – 2 Business Days</td>
                <td>$14.95</td>
              </tr>
              <tr>
                <td><strong>International Express (DHL)</strong></td>
                <td>4 – 7 Business Days</td>
                <td>Calculated at checkout</td>
              </tr>
            </tbody>
          </table>
        </div>
        <p class="jotar-note-text"><em>*Orders placed before 2:00 PM EST Monday–Friday ship out the same day.</em></p>
      </div>

      <!-- Returns Section -->
      <div class="jotar-section-block">
        <h2>2. Easy 30-Day Return & Exchange Process</h2>
        <p>We want you to feel 100% confident in your NOVA sneakers. If the fit isn't right, return or exchange unworn items within 30 days of delivery.</p>

        <div class="jotar-steps-grid">
          <div class="jotar-step-card">
            <span class="jotar-step-num">1</span>
            <h4>Start Request</h4>
            <p>Email our support team with your order number and request a prepaid label.</p>
          </div>
          <div class="jotar-step-card">
            <span class="jotar-step-num">2</span>
            <h4>Pack Shoes</h4>
            <p>Place unworn sneakers in their original box and attach the label.</p>
          </div>
          <div class="jotar-step-card">
            <span class="jotar-step-num">3</span>
            <h4>Fast Refund</h4>
            <p>Once received at our warehouse, your refund or swap is processed in 48 hours.</p>
          </div>
        </div>
      </div>
    </div>

    <!-- Support CTA -->
    <div class="jotar-shipping-cta">
      <h3>Need assistance with a shipment or return?</h3>
      <p>Our dedicated customer concierge is ready to assist you.</p>
      <a href="mailto:support@novasneakers.com" class="jotar-btn-black">Contact Support &rarr;</a>
    </div>
  </div>
</div>

<style>
  .jotar-shipping-hero { text-align: center; max-width: 800px; margin: 0 auto 40px; }
  .jotar-shipping-strip {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    background: #111;
    color: #fff;
    border-radius: 16px;
    padding: 28px 32px;
    margin-bottom: 50px;
  }
  .jotar-strip-item { display: flex; align-items: center; gap: 16px; }
  .jotar-strip-icon { font-size: 28px; }
  .jotar-strip-item h4 { font-size: 16px; font-weight: 700; margin: 0 0 4px; color: #fff; }
  .jotar-strip-item p { font-size: 13.5px; color: #aaa; margin: 0; }

  .jotar-shipping-details {
    display: flex;
    flex-direction: column;
    gap: 40px;
    margin-bottom: 60px;
  }
  .jotar-section-block h2 { font-size: 24px; font-weight: 800; text-transform: uppercase; margin: 0 0 16px; border-bottom: 2px solid #111; padding-bottom: 12px; }
  
  .jotar-table-responsive { overflow-x: auto; margin-bottom: 12px; }
  .jotar-custom-table {
    width: 100%;
    border-collapse: collapse;
    background: #ffffff;
    border: 1px solid #e8e8ed;
    border-radius: 12px;
    overflow: hidden;
  }
  .jotar-custom-table th, .jotar-custom-table td {
    padding: 16px 20px;
    text-align: left;
    border-bottom: 1px solid #eee;
    font-size: 14.5px;
  }
  .jotar-custom-table th {
    background: #f8f8fa;
    font-weight: 700;
    text-transform: uppercase;
    font-size: 12.5px;
    letter-spacing: 0.05em;
    color: #444;
  }
  .jotar-note-text { font-size: 13.5px; color: #777; margin: 0; }

  .jotar-steps-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    margin-top: 24px;
  }
  .jotar-step-card {
    background: #fbfbfb;
    border: 1px solid #e5e5e5;
    border-radius: 14px;
    padding: 28px 24px;
    position: relative;
  }
  .jotar-step-num {
    display: inline-flex;
    width: 32px;
    height: 32px;
    background: #111;
    color: #fff;
    border-radius: 50%;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 14px;
    margin-bottom: 14px;
  }
  .jotar-step-card h4 { font-size: 17px; font-weight: 700; margin: 0 0 8px; }
  .jotar-step-card p { font-size: 14px; color: #666; line-height: 1.5; margin: 0; }

  .jotar-shipping-cta {
    background: #f4f5f8;
    border-radius: 18px;
    padding: 40px;
    text-align: center;
  }
  .jotar-shipping-cta h3 { font-size: 24px; font-weight: 800; margin: 0 0 10px; }
  .jotar-shipping-cta p { font-size: 15px; color: #666; margin: 0 0 20px; }

  @media (max-width: 768px) {
    .jotar-shipping-strip { grid-template-columns: 1fr; gap: 16px; }
    .jotar-steps-grid { grid-template-columns: 1fr; }
  }
</style>

{% schema %}
{
  "name": "Jotar Shipping Returns",
  "settings": []
}
{% endschema %}
