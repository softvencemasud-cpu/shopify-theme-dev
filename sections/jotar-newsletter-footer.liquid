{% comment %}
  Jotar Footwear - Exact Reference Luxury Dark Newsletter & Footer
{% endcomment %}

<footer class="jotar-footer-section" id="jotar-footer-{{ section.id }}">
  <div class="jotar-container">
    <!-- 1. NEWSLETTER AREA (JOIN THE MOVEMENT) -->
    <div class="jotar-newsletter">
      <div class="jotar-newsletter__wrapper">
        <div class="jotar-newsletter__text">
          <h2 class="jotar-newsletter__heading">
            {{ section.settings.newsletter_heading | default: 'JOIN THE MOVEMENT' }}
          </h2>
          <p class="jotar-newsletter__subtext">
            {{ section.settings.newsletter_subtext | default: 'Be the first to know about new drops, exclusive offers, and more.' }}
          </p>
        </div>

        <div class="jotar-newsletter__form-wrap">
          {%- form 'customer', class: 'jotar-newsletter__form' -%}
            <input type="hidden" name="contact[tags]" value="newsletter">
            <div class="jotar-newsletter__input-group">
              <input
                type="email"
                name="contact[email]"
                class="jotar-newsletter__input"
                value="{{ form.email }}"
                aria-required="true"
                autocorrect="off"
                autocapitalize="off"
                autocomplete="email"
                placeholder="{{ section.settings.email_placeholder | default: 'Enter your email' }}"
                required
              >
              <button
                type="submit"
                class="jotar-newsletter__submit"
                name="commit"
              >
                {{ section.settings.subscribe_btn_label | default: 'SUBSCRIBE' }}
              </button>
            </div>
            {%- if form.posted_successfully? -%}
              <div class="jotar-newsletter__msg is-success">Thanks for subscribing! Check your inbox for updates.</div>
            {%- elsif form.errors -%}
              <div class="jotar-newsletter__msg is-error">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</div>
            {%- endif -%}
          {%- endform -%}
        </div>
      </div>
    </div>

    <!-- 2. FOOTER LINKS & BRAND GRID (5 COLUMNS) -->
    <div class="jotar-footer__grid">
      <!-- Brand Info Column -->
      <div class="jotar-footer__brand-col">
        <a href="{{ routes.root_url }}" class="jotar-footer__logo-link">
          <span class="jotar-footer__logo-text">JOTAR</span>
          <span class="jotar-footer__logo-sub">FOOTWEAR</span>
        </a>
        <p class="jotar-footer__tagline">
          {{ section.settings.brand_tagline | default: 'Built for every step. Designed for your lifestyle.' }}
        </p>
        <div class="jotar-footer__socials">
          <a href="https://instagram.com" class="jotar-footer__social-link" aria-label="Instagram" target="_blank" rel="noopener">
            <svg viewBox="0 0 24 24"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line></svg>
          </a>
          <a href="https://facebook.com" class="jotar-footer__social-link" aria-label="Facebook" target="_blank" rel="noopener">
            <svg viewBox="0 0 24 24"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path></svg>
          </a>
          <a href="https://youtube.com" class="jotar-footer__social-link" aria-label="YouTube" target="_blank" rel="noopener">
            <svg viewBox="0 0 24 24"><path d="M22.54 6.42a2.78 2.78 0 0 0-1.94-2C18.88 4 12 4 12 4s-6.88 0-8.6.46a2.78 2.78 0 0 0-1.94 2A29 29 0 0 0 1 11.75a29 29 0 0 0 .46 5.33A2.78 2.78 0 0 0 3.4 19c1.72.46 8.6.46 8.6.46s6.88 0 8.6-.46a2.78 2.78 0 0 0 1.94-2 29 29 0 0 0 .46-5.25 29 29 0 0 0-.46-5.33z"></path><polygon points="9.75 15.02 15.5 11.75 9.75 8.48 9.75 15.02"></polygon></svg>
          </a>
          <a href="https://tiktok.com" class="jotar-footer__social-link" aria-label="TikTok" target="_blank" rel="noopener">
            <svg viewBox="0 0 24 24"><path d="M9 12a4 4 0 1 0 4 4V4a5 5 0 0 0 5 5"></path></svg>
          </a>
        </div>
      </div>

      <!-- SHOP Column -->
      <div class="jotar-footer__nav-col">
        <h4 class="jotar-footer__title">SHOP</h4>
        <ul class="jotar-footer__list">
          <li><a href="/collections/all" class="jotar-footer__link">All Sneakers</a></li>
          <li><a href="/collections/all" class="jotar-footer__link">New Arrivals</a></li>
          <li><a href="/collections/all" class="jotar-footer__link">Best Sellers</a></li>
          <li><a href="/collections/all" class="jotar-footer__link">Collections</a></li>
          <li><a href="/collections/all" class="jotar-footer__link">Accessories</a></li>
        </ul>
      </div>

      <!-- COMPANY Column -->
      <div class="jotar-footer__nav-col">
        <h4 class="jotar-footer__title">COMPANY</h4>
        <ul class="jotar-footer__list">
          <li><a href="/pages/about" class="jotar-footer__link">About Us</a></li>
          <li><a href="/pages/our-story" class="jotar-footer__link">Our Story</a></li>
          <li><a href="/pages/careers" class="jotar-footer__link">Careers</a></li>
          <li><a href="/pages/sustainability" class="jotar-footer__link">Sustainability</a></li>
          <li><a href="/pages/press" class="jotar-footer__link">Press</a></li>
        </ul>
      </div>

      <!-- HELP Column -->
      <div class="jotar-footer__nav-col">
        <h4 class="jotar-footer__title">HELP</h4>
        <ul class="jotar-footer__list">
          <li><a href="/pages/faq" class="jotar-footer__link">FAQ</a></li>
          <li><a href="/pages/shipping-returns" class="jotar-footer__link">Shipping & Returns</a></li>
          <li><a href="/pages/size-guide" class="jotar-footer__link">Size Guide</a></li>
          <li><a href="/pages/track-order" class="jotar-footer__link">Track Order</a></li>
          <li><a href="/pages/contact" class="jotar-footer__link">Contact Us</a></li>
        </ul>
      </div>

      <!-- LEGAL Column -->
      <div class="jotar-footer__nav-col">
        <h4 class="jotar-footer__title">LEGAL</h4>
        <ul class="jotar-footer__list">
          <li><a href="/pages/terms-of-service" class="jotar-footer__link">Terms of Service</a></li>
          <li><a href="/pages/privacy-policy" class="jotar-footer__link">Privacy Policy</a></li>
          <li><a href="/pages/refund-policy" class="jotar-footer__link">Refund Policy</a></li>
          <li><a href="/pages/cookies-policy" class="jotar-footer__link">Cookies Policy</a></li>
        </ul>
      </div>
    </div>

    <!-- 3. BOTTOM COPYRIGHT & PAYMENT BADGES -->
    <div class="jotar-footer__bottom">
      <div class="jotar-footer__copy">
        © {{ 'now' | date: '%Y' }} JOTAR Footwear. All rights reserved.
      </div>
      <div class="jotar-footer__payments">
        <!-- Visa -->
        <span class="jotar-pay-badge">VISA</span>
        <!-- Mastercard -->
        <span class="jotar-pay-badge jotar-pay-badge--mc">
          <span class="mc-dot mc-red"></span>
          <span class="mc-dot mc-orange"></span>
        </span>
        <!-- PayPal -->
        <span class="jotar-pay-badge jotar-pay-badge--paypal">PayPal</span>
        <!-- Apple Pay -->
        <span class="jotar-pay-badge"> Pay</span>
      </div>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Jotar Footer Global",
  "settings": [
    {
      "type": "text",
      "id": "newsletter_heading",
      "label": "Newsletter Heading",
      "default": "JOIN THE MOVEMENT"
    },
    {
      "type": "textarea",
      "id": "newsletter_subtext",
      "label": "Newsletter Subtext",
      "default": "Be the first to know about new drops, exclusive offers, and more."
    },
    {
      "type": "text",
      "id": "email_placeholder",
      "label": "Email Placeholder",
      "default": "Enter your email"
    },
    {
      "type": "text",
      "id": "subscribe_btn_label",
      "label": "Subscribe Button Label",
      "default": "SUBSCRIBE"
    },
    {
      "type": "text",
      "id": "brand_tagline",
      "label": "Brand Tagline",
      "default": "Built for every step. Designed for your lifestyle."
    }
  ],
  "presets": [
    {
      "name": "Jotar Footer Global"
    }
  ]
}
{% endschema %}
