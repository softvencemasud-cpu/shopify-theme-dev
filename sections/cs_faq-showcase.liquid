{% liquid
  assign faq_image = section.settings.featured_image
  assign faq_image_alt = section.settings.image_alt | default: faq_image.alt | default: section.settings.heading
  assign phone_href = section.settings.phone_link
  if phone_href == blank
    assign clean_phone = section.settings.phone_number | remove: ' ' | remove: '(' | remove: ')' | remove: '-' | remove: '.'
    assign phone_href = 'tel:' | append: clean_phone
  endif
%}

<section
  id="CustomFaqShowcase-{{ section.id }}"
  class="custom-faq-showcase custom-faq-showcase--{{ section.id }} {{ section.settings.custom_class | escape }}"
  data-custom-faq-showcase
  data-allow-multiple="{{ section.settings.allow_multiple }}"
  data-animation-duration="{{ section.settings.animation_duration }}"
  style="
    --cfs-left-bg: {{ section.settings.left_background }};
    --cfs-right-bg: {{ section.settings.right_background }};
    --cfs-left-width: {{ section.settings.left_split_width }}%;
    --cfs-content-max: {{ section.settings.content_max_width }}px;
    --cfs-pt: {{ section.settings.desktop_padding_top }}px;
    --cfs-pb: {{ section.settings.desktop_padding_bottom }}px;
    --cfs-mobile-pt: {{ section.settings.mobile_padding_top }}px;
    --cfs-mobile-pb: {{ section.settings.mobile_padding_bottom }}px;
    --cfs-column-gap: {{ section.settings.desktop_column_gap }}px;
    --cfs-mobile-side: {{ section.settings.mobile_side_padding }}px;
    --cfs-min-height: {{ section.settings.desktop_min_height }}px;
    --cfs-image-width: {{ section.settings.image_width }}px;
    --cfs-image-height: {{ section.settings.image_height }}px;
    --cfs-image-mobile-height: {{ section.settings.image_mobile_height }}px;
    --cfs-image-radius: {{ section.settings.image_radius }}px;
    --cfs-image-position: {{ section.settings.image_focal_position }};
    --cfs-image-overlay: {{ section.settings.image_overlay_opacity | divided_by: 100.0 }};
    --cfs-contact-bg: {{ section.settings.contact_background }};
    --cfs-contact-text: {{ section.settings.contact_text_color }};
    --cfs-contact-icon-bg: {{ section.settings.contact_icon_background }};
    --cfs-contact-icon: {{ section.settings.contact_icon_color }};
    --cfs-contact-radius: {{ section.settings.contact_radius }}px;
    --cfs-contact-padding: {{ section.settings.contact_padding }}px;
    --cfs-contact-width: {{ section.settings.contact_width }}px;
    --cfs-contact-x: {{ section.settings.contact_x }}px;
    --cfs-contact-y: {{ section.settings.contact_y }}px;
    --cfs-eyebrow-text: {{ section.settings.eyebrow_text_color }};
    --cfs-eyebrow-border: {{ section.settings.eyebrow_border_color }};
    --cfs-eyebrow-bg: {{ section.settings.eyebrow_background }};
    --cfs-eyebrow-size: {{ section.settings.eyebrow_font_size }}px;
    --cfs-eyebrow-radius: {{ section.settings.eyebrow_radius }}px;
    --cfs-eyebrow-px: {{ section.settings.eyebrow_padding_x }}px;
    --cfs-eyebrow-py: {{ section.settings.eyebrow_padding_y }}px;
    --cfs-eyebrow-border-width: {{ section.settings.eyebrow_border_width }}px;
    --cfs-heading-color: {{ section.settings.heading_color }};
    --cfs-heading-desktop: {{ section.settings.heading_size_desktop }}px;
    --cfs-heading-tablet: {{ section.settings.heading_size_tablet }}px;
    --cfs-heading-mobile: {{ section.settings.heading_size_mobile }}px;
    --cfs-heading-weight: {{ section.settings.heading_weight }};
    --cfs-heading-line-height: {{ section.settings.heading_line_height }};
    --cfs-heading-bottom: {{ section.settings.heading_bottom_spacing }}px;
    --cfs-heading-max: {{ section.settings.heading_max_width }}px;
    --cfs-faq-bg: {{ section.settings.faq_background }};
    --cfs-faq-border: {{ section.settings.faq_border_color }};
    --cfs-faq-border-width: {{ section.settings.faq_border_width }}px;
    --cfs-faq-radius: {{ section.settings.faq_radius }}px;
    --cfs-question-color: {{ section.settings.question_color }};
    --cfs-answer-color: {{ section.settings.answer_color }};
    --cfs-divider-color: {{ section.settings.divider_color }};
    --cfs-icon-border: {{ section.settings.icon_border_color }};
    --cfs-icon-color: {{ section.settings.icon_color }};
    --cfs-icon-bg: {{ section.settings.icon_background }};
    --cfs-question-desktop: {{ section.settings.question_size_desktop }}px;
    --cfs-question-mobile: {{ section.settings.question_size_mobile }}px;
    --cfs-answer-desktop: {{ section.settings.answer_size_desktop }}px;
    --cfs-answer-mobile: {{ section.settings.answer_size_mobile }}px;
    --cfs-faq-py: {{ section.settings.faq_padding_y }}px;
    --cfs-faq-px: {{ section.settings.faq_padding_x }}px;
    --cfs-faq-gap: {{ section.settings.faq_item_gap }}px;
    --cfs-duration: {{ section.settings.animation_duration }}ms;
  "
>
  <div class="custom-faq-showcase__background" aria-hidden="true">
    <span class="custom-faq-showcase__background-left"></span>
    <span class="custom-faq-showcase__background-right"></span>
  </div>

  <div class="custom-faq-showcase__inner">
    <div class="custom-faq-showcase__media-column">
      <div class="custom-faq-showcase__image-shell{% if section.settings.enable_image_shadow %} custom-faq-showcase__image-shell--shadow{% endif %}{% if section.settings.show_contact_card and section.settings.mobile_contact_placement == 'below' %} custom-faq-showcase__image-shell--contact-below{% endif %}">
        {% if faq_image != blank %}
          {{
            faq_image
            | image_url: width: 1400
            | image_tag:
              class: 'custom-faq-showcase__image',
              widths: '360, 480, 640, 760, 900, 1100, 1400',
              sizes: '(min-width: 1200px) 548px, (min-width: 750px) 46vw, calc(100vw - 40px)',
              alt: faq_image_alt,
              loading: 'lazy'
          }}
        {% else %}
          {{ 'image' | placeholder_svg_tag: 'custom-faq-showcase__placeholder' }}
        {% endif %}
        <span class="custom-faq-showcase__image-overlay" aria-hidden="true"></span>

        {% if section.settings.show_contact_card %}
          <a
            class="custom-faq-showcase__contact-card custom-faq-showcase__contact-card--{{ section.settings.mobile_contact_placement }}"
            href="{{ phone_href }}"
            aria-label="Call {{ section.settings.phone_number | escape }}"
          >
            <span class="custom-faq-showcase__contact-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="24" height="24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M8.17 3.5H5.64c-.63 0-1.14.51-1.14 1.14 0 8.21 6.65 14.86 14.86 14.86.63 0 1.14-.51 1.14-1.14v-2.53c0-.55-.39-1.02-.93-1.12l-3.42-.68c-.49-.1-.99.08-1.31.47l-.75.91a12.19 12.19 0 0 1-5.5-5.5l.91-.75c.39-.32.57-.82.47-1.31l-.68-3.42a1.14 1.14 0 0 0-1.12-.93Z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </span>
            <span class="custom-faq-showcase__contact-copy">
              <span class="custom-faq-showcase__phone">{{ section.settings.phone_number | escape }}</span>
              {% if section.settings.contact_supporting_text != blank %}
                <span class="custom-faq-showcase__supporting">{{ section.settings.contact_supporting_text | escape }}</span>
              {% endif %}
            </span>
          </a>
        {% endif %}
      </div>
    </div>

    <div class="custom-faq-showcase__content-column">
      {% if section.settings.show_eyebrow and section.settings.eyebrow_text != blank %}
        <div class="custom-faq-showcase__eyebrow">{{ section.settings.eyebrow_text | escape }}</div>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h2 class="custom-faq-showcase__heading">{{ section.settings.heading | escape }}</h2>
      {% endif %}

      <div class="custom-faq-showcase__accordion" role="presentation">
        {% for block in section.blocks %}
          {% liquid
            assign should_open = block.settings.open_by_default
            if section.settings.open_first_item and forloop.first
              assign should_open = true
            endif
          %}
          <div
            class="custom-faq-showcase__item{% if should_open %} is-open{% endif %}"
            data-faq-item
            {{ block.shopify_attributes }}
          >
            <h3 class="custom-faq-showcase__question-heading">
              <button
                class="custom-faq-showcase__question"
                type="button"
                aria-expanded="{% if should_open %}true{% else %}false{% endif %}"
                aria-controls="CustomFaqPanel-{{ section.id }}-{{ block.id }}"
                id="CustomFaqButton-{{ section.id }}-{{ block.id }}"
                data-faq-toggle
              >
                <span>{{ block.settings.question | escape }}</span>
                <span class="custom-faq-showcase__chevron" aria-hidden="true">
                  <svg viewBox="0 0 20 20" width="18" height="18" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="m7.5 4.75 5.25 5.25-5.25 5.25" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </span>
              </button>
            </h3>

            <div
              class="custom-faq-showcase__answer-panel"
              id="CustomFaqPanel-{{ section.id }}-{{ block.id }}"
              role="region"
              aria-labelledby="CustomFaqButton-{{ section.id }}-{{ block.id }}"
              aria-hidden="{% if should_open %}false{% else %}true{% endif %}"
              {% unless should_open %}inert{% endunless %}
              data-faq-panel
            >
              <div class="custom-faq-showcase__answer-inner">
                <div class="custom-faq-showcase__divider" aria-hidden="true"></div>
                <div class="custom-faq-showcase__answer rte">{{ block.settings.answer }}</div>
              </div>
            </div>
          </div>
        {% endfor %}
      </div>
    </div>
  </div>
</section>

<style>
  #CustomFaqShowcase-{{ section.id }} {
    position: relative;
    isolation: isolate;
    min-height: var(--cfs-min-height);
    padding: var(--cfs-pt) 0 var(--cfs-pb);
    overflow: hidden;
    color: var(--cfs-heading-color);
  }

  #CustomFaqShowcase-{{ section.id }} *,
  #CustomFaqShowcase-{{ section.id }} *::before,
  #CustomFaqShowcase-{{ section.id }} *::after {
    box-sizing: border-box;
  }

  #CustomFaqShowcase-{{ section.id }} .custom-faq-showcase__background {
    position: absolute;
    inset: 0;
    z-index: -2;
    display: flex;
    pointer-events: none;
  }

  #CustomFaqShowcase-{{ section.id }} .custom-faq-showcase__background-left {
    width: var(--cfs-left-width);
    flex: 0 0 var(--cfs-left-width);
    background: var(--cfs-left-bg);
  }

  #CustomFaqShowcase-{{ section.id }} .custom-faq-showcase__background-right {
    flex: 1 1 auto;
    background: var(--cfs-right-bg);
  }

  #CustomFaqShowcase-{{ section.id }} .custom-faq-showcase__inner {
    width: min(calc(100% - 40px), var(--cfs-content-max));
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 560px);
    gap: var(--cfs-column-gap);
    align-items: start;
  }

  #CustomFaqShowcase-{{ section.id }} .custom-faq-showcase__media-column {
    width: min(100%, var(--cfs-image-width));
    justify-self: center;
    min-width: 0;
  }

  #CustomFaqShowcase-{{ section.id }} .custom-faq-showcase__image-shell {
    position: relative;
    width: 100%;
    height: var(--cfs-image-height);
    border-radius: var(--cfs-image-radius);
    overflow: hidden;
    background: rgba(255, 255, 255, 0.18);
  }

  #CustomFaqShowcase-{{ section.id }} .custom-faq-showcase__image-shell--shadow {
    box-shadow: 0 16px 38px rgba(16, 61, 18, 0.12);
  }

  #CustomFaqShowcase-{{ section.id }} .custom-faq-showcase__image,
  #CustomFaqShowcase-{{ section.id }} .custom-faq-showcase__placeholder {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--cfs-image-position);
  }

  #CustomFaqShowcase-{{ section.id }} .custom-faq-showcase__placeholder {
    background: rgba(255, 255, 255, 0.25);
    color: rgba(16, 61, 18, 0.28);
  }

  #CustomFaqShowcase-{{ section.id }} .custom-faq-showcase__image-overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: #000;
    opacity: var(--cfs-image-overlay);
    pointer-events: none;
  }

  #CustomFaqShowcase-{{ section.id }} .custom-faq-showcase__contact-card {
    position: absolute;
    z-index: 2;
    right: var(--cfs-contact-x);
    bottom: var(--cfs-contact-y);
    display: flex;
    align-items: center;
    gap: 14px;
    width: min(var(--cfs-contact-width), calc(100% - 24px));
    min-height: 92px;
    padding: var(--cfs-contact-padding);
    border-radius: var(--cfs-contact-radius);
    background: var(--cfs-contact-bg);
    color: var(--cfs-contact-text);
    text-decoration: none;
    line-height: 1.2;
  }


  #CustomFaqShowcase-{{ section.id }} .custom-faq-showcase__contact-card:focus-visible,
  #CustomFaqShowcase-{{ section.id }} .custom-faq-showcase__question:focus-visible {
    outline: 3px solid currentColor;
    outline-offset: 3px;
  }

  #CustomFaqShowcase-{{ section.id }} .custom-faq-showcase__contact-icon {
    display: grid;
    place-items: center;
    flex: 0 0 54px;
    width: 54px;
    height: 54px;
    border-radius: 999px;
    background: var(--cfs-contact-icon-bg);
    color: var(--cfs-contact-icon);
  }

  #CustomFaqShowcase-{{ section.id }} .custom-faq-showcase__contact-copy {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 5px;
  }

  #CustomFaqShowcase-{{ section.id }} .custom-faq-showcase__phone {
    display: block;
    font-size: clamp(17px, 1.45vw, 21px);
    font-weight: 750;
    letter-spacing: -0.02em;
    white-space: nowrap;
  }

  #CustomFaqShowcase-{{ section.id }} .custom-faq-showcase__supporting {
    display: block;
    font-size: 14px;
    font-weight: 650;
  }

  #CustomFaqShowcase-{{ section.id }} .custom-faq-showcase__content-column {
    min-width: 0;
    width: 100%;
  }

  #CustomFaqShowcase-{{ section.id }} .custom-faq-showcase__eyebrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: fit-content;
    padding: var(--cfs-eyebrow-py) var(--cfs-eyebrow-px);
    border: var(--cfs-eyebrow-border-width) solid var(--cfs-eyebrow-border);
    border-radius: var(--cfs-eyebrow-radius);
    background: var(--cfs-eyebrow-bg);
    color: var(--cfs-eyebrow-text);
    font-size: var(--cfs-eyebrow-size);
    font-weight: 700;
    line-height: 1;
  }

  #CustomFaqShowcase-{{ section.id }} .custom-faq-showcase__heading {
    max-width: var(--cfs-heading-max);
    margin: 18px 0 var(--cfs-heading-bottom);
    color: var(--cfs-heading-color);
    font-family: inherit;
    font-size: var(--cfs-heading-desktop);
    font-weight: var(--cfs-heading-weight);
    line-height: var(--cfs-heading-line-height);
    letter-spacing: -0.035em;
  }

  #CustomFaqShowcase-{{ section.id }} .custom-faq-showcase__accordion {
    display: flex;
    flex-direction: column;
    gap: var(--cfs-faq-gap);
  }

  #CustomFaqShowcase-{{ section.id }} .custom-faq-showcase__item {
    overflow: hidden;
    border: var(--cfs-faq-border-width) solid var(--cfs-faq-border);
    border-radius: var(--cfs-faq-radius);
    background: var(--cfs-faq-bg);
  }

  #CustomFaqShowcase-{{ section.id }} .custom-faq-showcase__question-heading {
    margin: 0;
  }

  #CustomFaqShowcase-{{ section.id }} .custom-faq-showcase__question {
    appearance: none;
    width: 100%;
    min-height: 74px;
    margin: 0;
    padding: var(--cfs-faq-py) var(--cfs-faq-px);
    border: 0;
    background: transparent;
    color: var(--cfs-question-color);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    text-align: left;
    font: inherit;
    font-size: var(--cfs-question-desktop);
    font-weight: 750;
    line-height: 1.35;
  }

  #CustomFaqShowcase-{{ section.id }} .custom-faq-showcase__question > span:first-child {
    min-width: 0;
    overflow-wrap: anywhere;
  }

  #CustomFaqShowcase-{{ section.id }} .custom-faq-showcase__chevron {
    display: grid;
    place-items: center;
    flex: 0 0 34px;
    width: 34px;
    height: 34px;
    border: 1px solid var(--cfs-icon-border);
    border-radius: 999px;
    background: var(--cfs-icon-bg);
    color: var(--cfs-icon-color);
  }

  #CustomFaqShowcase-{{ section.id }} .custom-faq-showcase__chevron svg {
    transition: transform var(--cfs-duration) ease;
  }

  #CustomFaqShowcase-{{ section.id }} .custom-faq-showcase__item.is-open .custom-faq-showcase__chevron svg {
    transform: rotate(90deg);
  }

  #CustomFaqShowcase-{{ section.id }} .custom-faq-showcase__answer-panel {
    height: 0;
    overflow: hidden;
    visibility: hidden;
    transition: height var(--cfs-duration) ease, visibility 0s linear var(--cfs-duration);
  }

  #CustomFaqShowcase-{{ section.id }} .custom-faq-showcase__item.is-open .custom-faq-showcase__answer-panel {
    visibility: visible;
    transition: height var(--cfs-duration) ease, visibility 0s linear 0s;
  }

  #CustomFaqShowcase-{{ section.id }} .custom-faq-showcase__answer-inner {
    padding: 0 var(--cfs-faq-px) calc(var(--cfs-faq-py) + 2px);
  }

  #CustomFaqShowcase-{{ section.id }} .custom-faq-showcase__divider {
    width: 100%;
    margin: 0 0 20px;
    border-top: 1px dashed var(--cfs-divider-color);
  }

  #CustomFaqShowcase-{{ section.id }} .custom-faq-showcase__answer {
    color: var(--cfs-answer-color);
    font-size: var(--cfs-answer-desktop);
    line-height: 1.55;
  }

  #CustomFaqShowcase-{{ section.id }} .custom-faq-showcase__answer > *:first-child {
    margin-top: 0;
  }

  #CustomFaqShowcase-{{ section.id }} .custom-faq-showcase__answer > *:last-child {
    margin-bottom: 0;
  }

  @media screen and (max-width: 1199px) and (min-width: 750px) {
    #CustomFaqShowcase-{{ section.id }} {
      min-height: auto;
    }

    #CustomFaqShowcase-{{ section.id }} .custom-faq-showcase__inner {
      grid-template-columns: minmax(0, 44%) minmax(0, 56%);
      gap: clamp(24px, 4vw, var(--cfs-column-gap));
    }

    #CustomFaqShowcase-{{ section.id }} .custom-faq-showcase__media-column {
      width: 100%;
    }

    #CustomFaqShowcase-{{ section.id }} .custom-faq-showcase__image-shell {
      height: min(var(--cfs-image-height), 56vw);
    }

    #CustomFaqShowcase-{{ section.id }} .custom-faq-showcase__heading {
      font-size: var(--cfs-heading-tablet);
    }

    #CustomFaqShowcase-{{ section.id }} .custom-faq-showcase__contact-card {
      right: 14px;
      bottom: 14px;
      width: min(var(--cfs-contact-width), calc(100% - 28px));
      min-height: 82px;
      gap: 10px;
      padding: min(var(--cfs-contact-padding), 16px);
    }

    #CustomFaqShowcase-{{ section.id }} .custom-faq-showcase__contact-icon {
      flex-basis: 46px;
      width: 46px;
      height: 46px;
    }

    #CustomFaqShowcase-{{ section.id }} .custom-faq-showcase__phone {
      font-size: clamp(15px, 1.8vw, 19px);
    }
  }

  @media screen and (max-width: 749px) {
    #CustomFaqShowcase-{{ section.id }} {
      min-height: 0;
      padding: 0;
      background: var(--cfs-right-bg);
      overflow: hidden;
    }

    #CustomFaqShowcase-{{ section.id }} .custom-faq-showcase__background {
      display: none;
    }

    #CustomFaqShowcase-{{ section.id }} .custom-faq-showcase__inner {
      width: calc(100% - (var(--cfs-mobile-side) * 2));
      display: flex;
      flex-direction: column;
      gap: 0;
    }

    #CustomFaqShowcase-{{ section.id }} .custom-faq-showcase__media-column,
    #CustomFaqShowcase-{{ section.id }} .custom-faq-showcase__content-column {
      position: relative;
      width: 100%;
      max-width: none;
      isolation: isolate;
    }

    #CustomFaqShowcase-{{ section.id }} .custom-faq-showcase__media-column {
      padding-top: var(--cfs-mobile-pt);
      padding-bottom: 38px;
      background: var(--cfs-left-bg);
      box-shadow: 0 0 0 100vmax var(--cfs-left-bg);
      clip-path: inset(0 -100vmax);
    }

    #CustomFaqShowcase-{{ section.id }} .custom-faq-showcase__content-column {
      padding-top: 42px;
      padding-bottom: var(--cfs-mobile-pb);
      background: var(--cfs-right-bg);
      box-shadow: 0 0 0 100vmax var(--cfs-right-bg);
      clip-path: inset(0 -100vmax);
    }

    #CustomFaqShowcase-{{ section.id }} .custom-faq-showcase__image-shell {
      width: 100%;
      height: min(var(--cfs-image-mobile-height), 125vw);
    }

    #CustomFaqShowcase-{{ section.id }} .custom-faq-showcase__contact-card {
      right: 14px;
      bottom: 14px;
      width: min(var(--cfs-contact-width), calc(100% - 28px));
      min-height: 78px;
      padding: min(var(--cfs-contact-padding), 15px);
      gap: 11px;
    }

    #CustomFaqShowcase-{{ section.id }} .custom-faq-showcase__contact-card--below {
      position: relative;
      right: auto;
      bottom: auto;
      width: 100%;
      margin-top: 14px;
    }

    #CustomFaqShowcase-{{ section.id }} .custom-faq-showcase__image-shell--contact-below {
      height: auto;
      overflow: visible;
      background: transparent;
    }

    #CustomFaqShowcase-{{ section.id }} .custom-faq-showcase__image-shell--contact-below .custom-faq-showcase__image,
    #CustomFaqShowcase-{{ section.id }} .custom-faq-showcase__image-shell--contact-below .custom-faq-showcase__placeholder,
    #CustomFaqShowcase-{{ section.id }} .custom-faq-showcase__image-shell--contact-below .custom-faq-showcase__image-overlay {
      height: min(var(--cfs-image-mobile-height), 125vw);
      border-radius: var(--cfs-image-radius);
    }

    #CustomFaqShowcase-{{ section.id }} .custom-faq-showcase__contact-icon {
      flex-basis: 46px;
      width: 46px;
      height: 46px;
    }

