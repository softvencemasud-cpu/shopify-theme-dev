<script>
  (() => {
    const selector = '[data-custom-faq-showcase]';

    function initialiseFaqShowcase(section) {
      if (!section || section.dataset.faqInitialised === 'true') return;
      section.dataset.faqInitialised = 'true';

      const allowMultiple = section.dataset.allowMultiple === 'true';
      const configuredDuration = Number.parseInt(section.dataset.animationDuration || '350', 10);
      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const duration = reducedMotion ? 0 : configuredDuration;
      const items = Array.from(section.querySelectorAll('[data-faq-item]'));

      function setPanelHeight(item, open, animate = true) {
        const button = item.querySelector('[data-faq-toggle]');
        const panel = item.querySelector('[data-faq-panel]');
        if (!button || !panel) return;

        window.clearTimeout(panel._faqTimer);

        if (open) {
          item.classList.add('is-open');
          button.setAttribute('aria-expanded', 'true');
          panel.setAttribute('aria-hidden', 'false');
          panel.removeAttribute('inert');

          if (!animate || duration === 0) {
            panel.style.height = 'auto';
            return;
          }

          panel.style.height = '0px';
          requestAnimationFrame(() => {
            panel.style.height = `${panel.scrollHeight}px`;
          });

          panel._faqTimer = window.setTimeout(() => {
            if (item.classList.contains('is-open')) panel.style.height = 'auto';
          }, duration + 30);
        } else {
          button.setAttribute('aria-expanded', 'false');
          panel.setAttribute('aria-hidden', 'true');
          panel.setAttribute('inert', '');

          if (!animate || duration === 0) {
            item.classList.remove('is-open');
            panel.style.height = '0px';
            return;
          }

          if (panel.style.height === 'auto' || !panel.style.height) {
            panel.style.height = `${panel.scrollHeight}px`;
          }

          requestAnimationFrame(() => {
            item.classList.remove('is-open');
            panel.style.height = '0px';
          });
        }
      }

      const initiallyOpen = items.filter((item) => item.classList.contains('is-open'));
      if (!allowMultiple && initiallyOpen.length > 1) {
        initiallyOpen.slice(1).forEach((item) => setPanelHeight(item, false, false));
      }

      items.forEach((item) => {
        const isOpen = item.classList.contains('is-open');
        setPanelHeight(item, isOpen, false);

        const button = item.querySelector('[data-faq-toggle]');
        if (!button) return;

        button.addEventListener('click', () => {
          const willOpen = !item.classList.contains('is-open');

          if (willOpen && !allowMultiple) {
            items.forEach((otherItem) => {
              if (otherItem !== item && otherItem.classList.contains('is-open')) {
                setPanelHeight(otherItem, false, true);
              }
            });
          }

          setPanelHeight(item, willOpen, true);
        });
      });

      section.addEventListener('faq:open-block', (event) => {
        const item = event.detail && event.detail.item;
        if (!item) return;

        if (!allowMultiple) {
          items.forEach((otherItem) => {
            if (otherItem !== item && otherItem.classList.contains('is-open')) {
              setPanelHeight(otherItem, false, false);
            }
          });
        }
        setPanelHeight(item, true, false);
      });
    }

    function initialiseAll(root = document) {
      root.querySelectorAll(selector).forEach(initialiseFaqShowcase);
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', () => initialiseAll(document), { once: true });
    } else {
      initialiseAll(document);
    }

    if (!window.__customFaqShowcaseThemeEventsBound) {
      window.__customFaqShowcaseThemeEventsBound = true;

      document.addEventListener('shopify:section:load', (event) => {
        initialiseAll(event.target);
      });

      document.addEventListener('shopify:block:select', (event) => {
        const item = event.target.closest('[data-faq-item]');
        const section = event.target.closest(selector);
        if (!item || !section) return;
        section.dispatchEvent(new CustomEvent('faq:open-block', { detail: { item } }));
      });
    }
  })();
</script>

