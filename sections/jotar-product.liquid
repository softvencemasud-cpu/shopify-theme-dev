{% comment %}
  Jotar Footwear - Exact Reference Single Product Page (PDP)
{% endcomment %}

<div class="jotar-pdp" id="jotar-pdp-{{ section.id }}" data-product-id="{{ product.id }}">
  <div class="jotar-container">
    <!-- Top Breadcrumb & Actions Bar -->
    <div class="jotar-pdp__top-bar">
      <nav class="jotar-pdp__breadcrumb" aria-label="Breadcrumb">
        <a href="{{ routes.root_url }}">Home</a>
        <span class="jotar-pdp__sep">›</span>
        <a href="/collections/all">Sneakers</a>
        <span class="jotar-pdp__sep">›</span>
        <span class="jotar-pdp__current">{{ product.title }}</span>
      </nav>

      <div class="jotar-pdp__top-actions">
        <button class="jotar-pdp__icon-btn jotar-pdp__wishlist-btn" aria-label="Save to Wishlist" type="button">
          <svg viewBox="0 0 24 24" width="18" height="18" stroke="currentColor" stroke-width="2" fill="none">
            <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
          </svg>
        </button>
        <button class="jotar-pdp__icon-btn jotar-pdp__share-btn" aria-label="Share Product" type="button" onclick="navigator.share ? navigator.share({title: '{{ product.title | escape }}', url: window.location.href}) : navigator.clipboard.writeText(window.location.href).then(() => alert('Link copied to clipboard!'))">
          <svg viewBox="0 0 24 24" width="18" height="18" stroke="currentColor" stroke-width="2" fill="none">
            <circle cx="18" cy="5" r="3"></circle>
            <circle cx="6" cy="12" r="3"></circle>
            <circle cx="18" cy="19" r="3"></circle>
            <line x1="8.59" y1="13.51" x2="15.42" y2="17.49"></line>
            <line x1="15.41" y1="6.51" x2="8.59" y2="10.49"></line>
          </svg>
        </button>
      </div>
    </div>

    <!-- Main PDP Grid (2 Columns: Left Gallery, Right Buy Box) -->
    <div class="jotar-pdp__grid">
      <!-- LEFT COLUMN: Gallery + Feature Highlights -->
      <div class="jotar-pdp__left-col">
        <!-- Main Media Frame -->
        <div class="jotar-pdp__main-image-wrap">
          {%- if product.compare_at_price > product.price -%}
            <span class="jotar-pdp__badge jotar-badge--sale">Sale</span>
          {%- else -%}
            <span class="jotar-pdp__badge jotar-badge--new">New</span>
          {%- endif -%}

          <button class="jotar-pdp__zoom-btn" aria-label="Zoom Image" type="button" onclick="window.open(document.getElementById('jotar-pdp-main-img').src, '_blank')">
            <svg viewBox="0 0 24 24" width="18" height="18" stroke="currentColor" stroke-width="2.5" fill="none">
              <circle cx="11" cy="11" r="8"></circle>
              <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
              <line x1="11" y1="8" x2="11" y2="14"></line>
              <line x1="8" y1="11" x2="14" y2="11"></line>
            </svg>
          </button>

          <img
            id="jotar-pdp-main-img"
            src="{{ product.featured_media | default: product.featured_image | image_url: width: 1200 }}"
            alt="{{ product.title | escape }}"
            class="jotar-pdp__main-image"
            loading="eager"
          >
        </div>

        <!-- Thumbnails Strip -->
        <div class="jotar-pdp__thumbnails">
          {%- if product.media.size > 1 -%}
            {%- for media in product.media limit: 5 -%}
              <button
                type="button"
                class="jotar-pdp__thumb{% if forloop.first %} is-active{% endif %}"
                data-target-src="{{ media | image_url: width: 1200 }}"
                aria-label="View Image {{ forloop.index }}"
                onclick="document.querySelectorAll('.jotar-pdp__thumb').forEach(t=>t.classList.remove('is-active')); this.classList.add('is-active'); document.getElementById('jotar-pdp-main-img').src = this.dataset.targetSrc;"
              >
                <img src="{{ media | image_url: width: 200 }}" alt="{{ product.title | escape }}" loading="lazy">
              </button>
            {%- endfor -%}
          {%- else -%}
            <!-- Fallback Thumbnails from Assets for Rich Multi-angle Experience -->
            <button
              type="button"
              class="jotar-pdp__thumb is-active"
              data-target-src="{{ product.featured_image | default: 'jotar-prod-01.jpg' | asset_url }}"
              onclick="document.querySelectorAll('.jotar-pdp__thumb').forEach(t=>t.classList.remove('is-active')); this.classList.add('is-active'); document.getElementById('jotar-pdp-main-img').src = this.dataset.targetSrc;"
            >
              <img src="{{ product.featured_image | default: 'jotar-prod-01.jpg' | asset_url }}" alt="Profile View">
            </button>
            <button
              type="button"
              class="jotar-pdp__thumb"
              data-target-src="{{ 'jotar-prod-02.jpg' | asset_url }}"
              onclick="document.querySelectorAll('.jotar-pdp__thumb').forEach(t=>t.classList.remove('is-active')); this.classList.add('is-active'); document.getElementById('jotar-pdp-main-img').src = this.dataset.targetSrc;"
            >
              <img src="{{ 'jotar-prod-02.jpg' | asset_url }}" alt="Pair Angle View">
            </button>
            <button
              type="button"
              class="jotar-pdp__thumb"
              data-target-src="{{ 'jotar-prod-03.jpg' | asset_url }}"
              onclick="document.querySelectorAll('.jotar-pdp__thumb').forEach(t=>t.classList.remove('is-active')); this.classList.add('is-active'); document.getElementById('jotar-pdp-main-img').src = this.dataset.targetSrc;"
            >
              <img src="{{ 'jotar-prod-03.jpg' | asset_url }}" alt="Outsole Sole View">
            </button>
            <button
              type="button"
              class="jotar-pdp__thumb"
              data-target-src="{{ 'jotar-prod-04.jpg' | asset_url }}"
              onclick="document.querySelectorAll('.jotar-pdp__thumb').forEach(t=>t.classList.remove('is-active')); this.classList.add('is-active'); document.getElementById('jotar-pdp-main-img').src = this.dataset.targetSrc;"
            >
              <img src="{{ 'jotar-prod-04.jpg' | asset_url }}" alt="Heel View">
            </button>
            <button
              type="button"
              class="jotar-pdp__thumb"
              data-target-src="{{ 'jotar-prod-20.jpg' | asset_url }}"
              onclick="document.querySelectorAll('.jotar-pdp__thumb').forEach(t=>t.classList.remove('is-active')); this.classList.add('is-active'); document.getElementById('jotar-pdp-main-img').src = this.dataset.targetSrc;"
            >
              <img src="{{ 'jotar-prod-20.jpg' | asset_url }}" alt="Top Down View">
            </button>
          {%- endif -%}
        </div>

        <!-- 4-Feature Highlights Grid -->
        <div class="jotar-pdp__features">
          <div class="jotar-pdp__feature-item">
            <div class="jotar-pdp__feature-icon">
              <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
              </svg>
            </div>
            <h4 class="jotar-pdp__feature-title">Dynamic Performance</h4>
            <p class="jotar-pdp__feature-desc">Responsive cushioning for superior energy return.</p>
          </div>

          <div class="jotar-pdp__feature-item">
            <div class="jotar-pdp__feature-icon">
              <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
              </svg>
            </div>
            <h4 class="jotar-pdp__feature-title">Premium Build</h4>
            <p class="jotar-pdp__feature-desc">High-quality materials for lasting durability.</p>
          </div>

          <div class="jotar-pdp__feature-item">
            <div class="jotar-pdp__feature-icon">
              <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M20.24 12.24a6 6 0 0 0-8.49-8.49L5 10.5V19h8.5z"></path>
                <line x1="16" y1="8" x2="2" y2="22"></line>
                <line x1="17.5" y1="15" x2="9" y2="15"></line>
              </svg>
            </div>
            <h4 class="jotar-pdp__feature-title">Lightweight Comfort</h4>
            <p class="jotar-pdp__feature-desc">Designed for all-day wear without the extra weight.</p>
          </div>

          <div class="jotar-pdp__feature-item">
            <div class="jotar-pdp__feature-icon">
              <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"></circle>
                <path d="M8 12s1.5 2 4 2 4-2 4-2"></path>
                <line x1="9" y1="9" x2="9.01" y2="9"></line>
                <line x1="15" y1="9" x2="15.01" y2="9"></line>
              </svg>
            </div>
            <h4 class="jotar-pdp__feature-title">Superior Grip</h4>
            <p class="jotar-pdp__feature-desc">Advanced outsole for maximum traction.</p>
          </div>
        </div>
      </div>

      <!-- RIGHT COLUMN: Product Info & Purchase Panel -->
      <div class="jotar-pdp__right-col">
        <!-- Title -->
        <h1 class="jotar-pdp__title">{{ product.title }}</h1>

        <!-- Best Seller Badge -->
        <div class="jotar-pdp__tag-wrap">
          <span class="jotar-pdp__best-seller-tag">★ BEST SELLER</span>
        </div>

        <!-- Price & Discount Tag -->
        <div class="jotar-pdp__price-wrap">
          <span class="jotar-pdp__price-main">{{ product.selected_or_first_available_variant.price | money }}</span>
          {%- if product.compare_at_price > product.price -%}
            <span class="jotar-pdp__price-compare">{{ product.selected_or_first_available_variant.compare_at_price | money }}</span>
            {%- assign saving_pct = product.compare_at_price | minus: product.price | times: 100.0 | divided_by: product.compare_at_price | round -%}
            <span class="jotar-pdp__discount-pill">{{ saving_pct }}% OFF</span>
          {%- else -%}
            <span class="jotar-pdp__discount-pill">30% OFF</span>
          {%- endif -%}
        </div>

        <!-- Description Snippet -->
        <div class="jotar-pdp__summary">
          {{ product.description | strip_html | truncatewords: 25 | default: 'Built for forward momentum. The Nova Sprint features a responsive visible heel air pod with a pop of electric orange for dynamic road performance.' }}
        </div>

        <!-- Size Guide & Selector -->
        <div class="jotar-pdp__option-group">
          <div class="jotar-pdp__option-header">
            <span class="jotar-pdp__option-label">Size</span>
            <button type="button" class="jotar-pdp__size-guide-link" onclick="document.getElementById('jotar-size-modal').classList.add('is-open')">
              <svg viewBox="0 0 24 24" width="15" height="15" stroke="currentColor" stroke-width="2" fill="none">
                <path d="M21.3 8.7l-6-6a2 2 0 0 0-2.8 0L3 12.2a2 2 0 0 0 0 2.8l6 6a2 2 0 0 0 2.8 0l9.5-9.5a2 2 0 0 0 0-2.8z"></path>
                <line x1="7.5" y1="10.5" x2="8.5" y2="11.5"></line>
                <line x1="10.5" y1="7.5" x2="11.5" y2="8.5"></line>
                <line x1="13.5" y1="4.5" x2="14.5" y2="5.5"></line>
              </svg>
              Size guide
            </button>
          </div>

          <div class="jotar-pdp__sizes-grid">
            {%- assign sizes_array = 'EU 39,EU 40,EU 41,EU 42,EU 43,EU 44,EU 45,EU 46' | split: ',' -%}
            {%- for s in sizes_array -%}
              <button
                type="button"
                class="jotar-pdp__size-pill{% if forloop.first %} is-selected{% endif %}"
                data-size="{{ s }}"
                onclick="document.querySelectorAll('.jotar-pdp__size-pill').forEach(b=>b.classList.remove('is-selected')); this.classList.add('is-selected');"
              >
                {{ s }}
              </button>
            {%- endfor -%}
          </div>
        </div>

        <!-- Color Selector -->
        <div class="jotar-pdp__option-group">
          <div class="jotar-pdp__option-header">
            <span class="jotar-pdp__option-label">Color: <strong id="jotar-selected-color-name">White / Graphite / Orange</strong></span>
          </div>
          <div class="jotar-pdp__colors-wrap">
            <button type="button" class="jotar-pdp__color-swatch is-selected" style="background-color: #ffffff; border: 2px solid #111;" data-color="White / Silver" onclick="document.querySelectorAll('.jotar-pdp__color-swatch').forEach(c=>c.classList.remove('is-selected')); this.classList.add('is-selected'); document.getElementById('jotar-selected-color-name').innerText='White / Graphite / Orange';"></button>
            <button type="button" class="jotar-pdp__color-swatch" style="background-color: #111111;" data-color="Triple Black" onclick="document.querySelectorAll('.jotar-pdp__color-swatch').forEach(c=>c.classList.remove('is-selected')); this.classList.add('is-selected'); document.getElementById('jotar-selected-color-name').innerText='Triple Black';"></button>
            <button type="button" class="jotar-pdp__color-swatch" style="background-color: #e65100;" data-color="Electric Orange" onclick="document.querySelectorAll('.jotar-pdp__color-swatch').forEach(c=>c.classList.remove('is-selected')); this.classList.add('is-selected'); document.getElementById('jotar-selected-color-name').innerText='Electric Orange / Black';"></button>
          </div>
        </div>

        <!-- Form Actions (Quantity + Add to Cart + Buy It Now) -->
        <form method="post" action="/cart/add" class="jotar-pdp__purchase-form" id="jotar-pdp-form">
          <input type="hidden" name="id" id="jotar-selected-variant-id" value="{{ product.selected_or_first_available_variant.id }}">

          <!-- Quantity + Add to Cart Row -->
          <div class="jotar-pdp__btn-row">
            <div class="jotar-pdp__qty-box">
              <button type="button" class="jotar-pdp__qty-btn" onclick="const q = document.getElementById('jotar-qty-input'); if(q.value > 1) q.value--;">−</button>
              <input type="number" id="jotar-qty-input" name="quantity" value="1" min="1" class="jotar-pdp__qty-input" readonly>
              <button type="button" class="jotar-pdp__qty-btn" onclick="const q = document.getElementById('jotar-qty-input'); q.value++;">+</button>
            </div>

            <button type="submit" class="jotar-pdp__add-btn">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
                <line x1="3" y1="6" x2="21" y2="6"></line>
                <path d="M16 10a4 4 0 0 1-8 0"></path>
              </svg>
              ADD TO CART
            </button>
          </div>

          <!-- Buy It Now Button -->
          <button type="button" class="jotar-pdp__buy-now-btn" onclick="document.getElementById('jotar-pdp-form').submit();">
            BUY IT NOW
          </button>
        </form>

        <!-- Free Shipping Assurance Note -->
        <div class="jotar-pdp__shipping-note">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="1" y="3" width="15" height="13"></rect>
            <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon>
            <circle cx="5.5" cy="18.5" r="2.5"></circle>
            <circle cx="18.5" cy="18.5" r="2.5"></circle>
          </svg>
          <span><strong>Free shipping</strong> on orders over $100</span>
        </div>

        <!-- 3 Accordion Dropdowns -->
        <div class="jotar-pdp__accordions">
          <!-- Accordion 1: Product Details -->
          <details class="jotar-pdp__accordion" open>
            <summary class="jotar-pdp__summary-head">
              <span class="jotar-pdp__head-left">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
                </svg>
                Product Details
              </span>
              <svg class="jotar-pdp__chevron" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5">
                <polyline points="6 9 12 15 18 9"></polyline>
              </svg>
            </summary>
            <div class="jotar-pdp__accordion-body">
              {{ product.description | default: '<p>Engineered for maximum agility and comfort. Crafted with breathable performance mesh, supportive structural overlays, and our signature high-response foam midsole.</p><ul><li>Upper: Breathable ballistic mesh & premium nubuck</li><li>Midsole: Ultra-responsive energy return cushioning</li><li>Outsole: High-abrasion traction rubber</li><li>Fit: True to size (EU Standard)</li></ul>' }}
            </div>
          </details>

          <!-- Accordion 2: Shipping & Returns -->
          <details class="jotar-pdp__accordion">
            <summary class="jotar-pdp__summary-head">
              <span class="jotar-pdp__head-left">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
                  <rect x="1" y="3" width="15" height="13"></rect>
                  <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon>
                </svg>
                Shipping & Returns
              </span>
              <svg class="jotar-pdp__chevron" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5">
                <polyline points="6 9 12 15 18 9"></polyline>
              </svg>
            </summary>
            <div class="jotar-pdp__accordion-body">
              <p>• Standard Express Delivery: 2–3 business days.</p>
              <p>• Free Returns: 30-day hassle-free unworn return policy.</p>
              <p>• 100% Guaranteed Authentic footwear with official manufacturer warranty.</p>
            </div>
          </details>

          <!-- Accordion 3: Care Instructions -->
          <details class="jotar-pdp__accordion">
            <summary class="jotar-pdp__summary-head">
              <span class="jotar-pdp__head-left">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                </svg>
                Care Instructions
              </span>
              <svg class="jotar-pdp__chevron" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5">
                <polyline points="6 9 12 15 18 9"></polyline>
              </svg>
            </summary>
            <div class="jotar-pdp__accordion-body">
              <p>• Wipe clean with a soft damp cloth using mild soap.</p>
              <p>• Do not machine wash or submerge in water.</p>
              <p>• Air dry away from direct heat and sunlight.</p>
            </div>
          </details>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Size Guide Modal -->
<div id="jotar-size-modal" class="jotar-modal-backdrop" onclick="if(event.target===this) this.classList.remove('is-open')">
  <div class="jotar-modal-box">
    <div class="jotar-modal-header">
      <h3>Sneaker Sizing Chart</h3>
      <button type="button" class="jotar-modal-close" onclick="document.getElementById('jotar-size-modal').classList.remove('is-open')">&times;</button>
    </div>
    <div class="jotar-modal-content">
      <table class="jotar-size-table">
        <thead>
          <tr>
            <th>EU Size</th>
            <th>US Men</th>
            <th>UK Size</th>
            <th>Foot Length (cm)</th>
          </tr>
        </thead>
        <tbody>
          <tr><td>EU 39</td><td>6.5</td><td>6.0</td><td>24.5 cm</td></tr>
          <tr><td>EU 40</td><td>7.0</td><td>6.5</td><td>25.0 cm</td></tr>
          <tr><td>EU 41</td><td>8.0</td><td>7.5</td><td>26.0 cm</td></tr>
          <tr><td>EU 42</td><td>8.5</td><td>8.0</td><td>26.5 cm</td></tr>
          <tr><td>EU 43</td><td>9.5</td><td>9.0</td><td>27.5 cm</td></tr>
          <tr><td>EU 44</td><td>10.0</td><td>9.5</td><td>28.0 cm</td></tr>
          <tr><td>EU 45</td><td>11.0</td><td>10.5</td><td>29.0 cm</td></tr>
          <tr><td>EU 46</td><td>12.0</td><td>11.5</td><td>30.0 cm</td></tr>
        </tbody>
      </table>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Jotar Single Product",
  "settings": [],
  "presets": [
    {
      "name": "Jotar Single Product"
    }
  ]
}
{% endschema %}
