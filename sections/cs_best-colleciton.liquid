{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}

<style>
  #shopify-section-{{ section.id }} .custom-bestsellers {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    background-color: {{ section.settings.bg_color }};
    text-align: center;
  }

  #shopify-section-{{ section.id }} .section-header {
    margin-bottom: 40px;
  }

  #shopify-section-{{ section.id }} .section-title {
    margin: 0 0 15px;
    color: {{ section.settings.text_color }};
    font-size: 32px;
    font-weight: 800;
    line-height: 1.2;
    letter-spacing: 1px;
    text-transform: uppercase;
  }

  /* Divider */
  #shopify-section-{{ section.id }} .divider-wrapper {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 15px;
    width: calc(100% - 40px);
    max-width: 400px;
    margin: 0 auto;
  }

  #shopify-section-{{ section.id }} .divider-line {
    flex-grow: 1;
    height: 1px;
    background-color: #cccccc;
  }

  #shopify-section-{{ section.id }} .divider-icon {
    flex-shrink: 0;
  }

  #shopify-section-{{ section.id }} .divider-icon img {
    display: block;
    width: auto;
    max-width: 30px;
    height: auto;
  }

  #shopify-section-{{ section.id }} .divider-icon svg {
    display: block;
    width: 24px;
    height: 24px;
    fill: {{ section.settings.text_color }};
  }

  /* Product Grid */
  #shopify-section-{{ section.id }} .product-grid {
    display: grid;
    grid-template-columns: repeat(
      {{ section.settings.products_per_row }},
      minmax(0, 1fr)
    );
    gap: 20px;
    width: 100%;
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 20px;
  }

  #shopify-section-{{ section.id }} .product-card {
    position: relative;
    min-width: 0;
    text-align: center;
  }

  /* Product Image */
  #shopify-section-{{ section.id }} .product-media {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 5;
    margin-bottom: 15px;
    overflow: hidden;
    background-color: #f4f4f4;
  }

  #shopify-section-{{ section.id }} .product-image-link {
    display: block;
    width: 100%;
    height: 100%;
    color: inherit;
    text-decoration: none;
  }

  #shopify-section-{{ section.id }} .product-image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  #shopify-section-{{ section.id }} .product-card:hover .product-image {
    transform: scale(1.03);
  }

  #shopify-section-{{ section.id }} .product-placeholder {
    display: block;
    width: 100%;
    height: 100%;
  }

  /*
   * Add to cart hover bar
   * Same style and animation as supplied code
   */
#shopify-section-{{ section.id }} .quick-add-wrapper {
  position: absolute;
  left: 10px;
  right: 10px;
  bottom: 10px;
  z-index: 3;
  display: flex;
  width: auto;
  background: transparent;
  opacity: 0;
  visibility: hidden;
  pointer-events: none;
  transform: translateY(calc(100% + 10px));
  transition:
    opacity 0.25s ease,
    visibility 0.25s ease,
    transform 0.25s ease;
}

  #shopify-section-{{ section.id }} .product-card:hover .quick-add-wrapper,
  #shopify-section-{{ section.id }} .quick-add-wrapper:focus-within {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translateY(0);
  }

  #shopify-section-{{ section.id }} .quick-add-button {
    position: relative;
    z-index: 0;
    flex: 1;
    width: 100%;
    min-height: 44px;
    margin: 0;
    padding: 12px 6px;
    overflow: hidden;
    border:
      {{ section.settings.hover_btn_border_width }}px
      solid
      {{ section.settings.hover_btn_border_color }};
    border-radius: 0;
    outline: none;
    background: {{ section.settings.hover_btn_bg }};
    color: {{ section.settings.hover_btn_color }};
    font: inherit;
    font-size: {{ section.settings.hover_btn_font_size }}px;
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: 0.04em;
    text-align: center;
    text-transform: uppercase;
    cursor: pointer;
    appearance: none;
    -webkit-appearance: none;
  }

  /* Bottom-to-top hover fill */
  #shopify-section-{{ section.id }} .quick-add-button::before {
    position: absolute;
    bottom: 0;
    left: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
    background: {{ section.settings.hover_btn_bg_hover }};
    content: "";
    transform: scaleY(0);
    transform-origin: bottom;
    transition: transform 0.35s ease;
  }

  #shopify-section-{{ section.id }} .quick-add-button span {
    position: relative;
    z-index: 1;
    display: inline-block;
    color: inherit;
    transition: color 0.35s ease;
  }

  #shopify-section-{{ section.id }} .quick-add-button:hover::before,
  #shopify-section-{{ section.id }} .quick-add-button:focus-visible::before {
    transform: scaleY(1);
  }

  #shopify-section-{{ section.id }} .quick-add-button:hover span,
  #shopify-section-{{ section.id }} .quick-add-button:focus-visible span {
    color: {{ section.settings.hover_btn_color_hover }};
  }

  #shopify-section-{{ section.id }} .quick-add-button.is-loading {
    opacity: 0.6;
    pointer-events: none;
  }

  #shopify-section-{{ section.id }} .quick-add-button:disabled {
    opacity: 1;
    cursor: not-allowed;
  }

  #shopify-section-{{ section.id }} .quick-add-button.is-sold-out {
    border-color: {{ section.settings.sold_out_btn_bg }};
    background: {{ section.settings.sold_out_btn_bg }};
    color: {{ section.settings.sold_out_btn_color }};
  }

  #shopify-section-{{ section.id }} .quick-add-button.is-sold-out::before {
    display: none;
  }

  #shopify-section-{{ section.id }} .quick-add-button.is-sold-out span,
  #shopify-section-{{ section.id }} .quick-add-button.is-sold-out:hover span {
    color: {{ section.settings.sold_out_btn_color }};
  }

  /* Product Information */
  #shopify-section-{{ section.id }} .product-info-link {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  #shopify-section-{{ section.id }} .product-title {
    margin: 0 0 5px;
    color: {{ section.settings.text_color }};
    font-size: 16px;
    font-weight: 700;
    line-height: 1.4;
  }

  #shopify-section-{{ section.id }} .product-price {
    margin-bottom: 10px;
    color: {{ section.settings.text_color }};
    font-size: 15px;
    font-weight: 600;
    line-height: 1.4;
  }

  #shopify-section-{{ section.id }} .compare-price {
    margin-left: 6px;
    font-size: 13px;
    font-weight: 400;
    opacity: 0.55;
    text-decoration: line-through;
  }

  /* Color Swatches */
  #shopify-section-{{ section.id }} .color-swatches {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 10px;
  }

  #shopify-section-{{ section.id }} .swatch {
    display: inline-block;
    width: 16px;
    height: 16px;
    border: 1px solid #dddddd;
    border-radius: 50%;
  }

  /* View All */
 #shopify-section-{{ section.id }} .view-all-wrapper {
  margin-top: 40px;
}

#shopify-section-{{ section.id }} .view-all-btn {
  position: relative;
  z-index: 0;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 44px;
  padding: 12px 30px;
  overflow: hidden;
  border:
    {{ section.settings.hover_btn_border_width }}px
    solid
    {{ section.settings.hover_btn_border_color }};
  border-radius: 0;
  background: {{ section.settings.hover_btn_bg }};
  color: {{ section.settings.hover_btn_color }};
  font: inherit;
  font-size: {{ section.settings.hover_btn_font_size }}px;
  font-weight: 600;
  line-height: 1.2;
  letter-spacing: 0.04em;
  text-align: center;
  text-transform: uppercase;
  text-decoration: none;
  transition: color 0.35s ease;
}

#shopify-section-{{ section.id }} .view-all-btn::before {
  content: "";
  position: absolute;
  bottom: 0;
  left: 0;
  z-index: 0;
  width: 100%;
  height: 100%;
  background: {{ section.settings.hover_btn_bg_hover }};
  transform: scaleY(0);
  transform-origin: bottom;
  transition: transform 0.35s ease;
}

#shopify-section-{{ section.id }} .view-all-btn span {
  position: relative;
  z-index: 1;
  color: inherit;
  transition: color 0.35s ease;
}

#shopify-section-{{ section.id }} .view-all-btn:hover::before,
#shopify-section-{{ section.id }} .view-all-btn:focus-visible::before {
  transform: scaleY(1);
}

#shopify-section-{{ section.id }} .view-all-btn:hover span,
#shopify-section-{{ section.id }} .view-all-btn:focus-visible span {
  color: {{ section.settings.hover_btn_color_hover }};
}

  /* Cart Notification */
  #shopify-section-{{ section.id }} .custom-cart-message {
    position: fixed;
    bottom: 30px;
    left: 50%;
    z-index: 9999;
    padding: 12px 24px;
    border-radius: 4px;
    background: #111111;
    color: #ffffff;
    font-size: 13px;
    pointer-events: none;
    opacity: 0;
    transform: translateX(-50%) translateY(10px);
    transition:
      opacity 0.3s ease,
      transform 0.3s ease;
  }

  #shopify-section-{{ section.id }} .custom-cart-message.is-visible {
    opacity: 1;
    transform: translateX(-50%) translateY(0);
  }

  /* Tablet */
  @media screen and (max-width: 1024px) {
    #shopify-section-{{ section.id }} .product-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  /* Mobile */
  @media screen and (max-width: 768px) {
    #shopify-section-{{ section.id }} .product-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 15px;
    }

    #shopify-section-{{ section.id }} .section-title {
      font-size: 26px;
    }

    #shopify-section-{{ section.id }} .quick-add-button {
      min-height: 42px;
      padding: 10px 5px;
      font-size: 10px;
    }
  }

  @media screen and (max-width: 480px) {
    #shopify-section-{{ section.id }} .product-grid {
      grid-template-columns: 1fr;
    }
  }

  /* Touch devices have no hover */
  @media (hover: none) {
    #shopify-section-{{ section.id }} .quick-add-wrapper {
      opacity: 1;
      visibility: visible;
      pointer-events: auto;
      transform: translateY(0);
    }

    #shopify-section-{{ section.id }} .product-card:hover .product-image {
      transform: none;
    }
  }
</style>

<section class="custom-bestsellers">
  <div class="section-header">
    {% if section.settings.heading != blank %}
      <h2 class="section-title">
        {{ section.settings.heading }}
      </h2>
    {% endif %}

    <div class="divider-wrapper">
      <div class="divider-line"></div>

      <div class="divider-icon">
        {% if section.settings.divider_icon != blank %}
          {{
            section.settings.divider_icon
            | image_url: width: 80
            | image_tag:
              loading: 'lazy',
              widths: '30, 60, 80',
              sizes: '30px',
              alt: section.settings.heading
          }}
        {% else %}
          <svg
            viewBox="0 0 24 24"
            xmlns="http://www.w3.org/2000/svg"
            aria-hidden="true"
          >
            <path d="M21.5 16.5c-1.5 0-2.5-1-3-2l-1-2.5c-.5-1-1.5-1.5-2.5-1.5h-6c-1 0-2 .5-2.5 1.5l-1 2.5c-.5 1-1.5 2-3 2H1v1.5h22v-1.5h-1.5zM7.5 9.5c0-2.5 2-4.5 4.5-4.5s4.5 2 4.5 4.5v1h-9v-1z"/>
          </svg>
        {% endif %}
      </div>

      <div class="divider-line"></div>
    </div>
  </div>

  {%- assign selected_collection = section.settings.collection -%}

  <div class="product-grid">
    {% if selected_collection != blank and selected_collection.products_count > 0 %}
      {% for product in selected_collection.products limit: section.settings.products_to_show %}
        {%- assign selected_variant = product.selected_or_first_available_variant -%}

        <article class="product-card">
          <div class="product-media">
            <a
              href="{{ product.url }}"
              class="product-image-link"
              aria-label="{{ product.title | escape }}"
            >
              {% if product.featured_image != blank %}
                {{
                  product.featured_image
                  | image_url: width: 900
                  | image_tag:
                    class: 'product-image',
                    loading: 'lazy',
                    widths: '300, 450, 600, 750, 900',
                    sizes: '(min-width: 1025px) 20vw, (min-width: 769px) 33vw, 50vw',
                    alt: product.featured_image.alt
                }}
              {% else %}
                {{ 'product-1' | placeholder_svg_tag: 'product-placeholder' }}
              {% endif %}
            </a>

            <div class="quick-add-wrapper">
              <button
                type="button"
                class="quick-add-button{% unless selected_variant.available %} is-sold-out{% endunless %}"
                data-custom-add-to-cart
                data-variant-id="{{ selected_variant.id }}"
                {% unless selected_variant.available %}
                  disabled
                {% endunless %}
                aria-label="{% if selected_variant.available %}Add {{ product.title | escape }} to cart{% else %}{{ product.title | escape }} is sold out{% endif %}"
              >
                <span>
                  {% if selected_variant.available %}
                    Add to Cart
                  {% else %}
                    Sold Out
                  {% endif %}
                </span>
              </button>
            </div>
          </div>

          <a href="{{ product.url }}" class="product-info-link">
            <h3 class="product-title">
              {{ product.title }}
            </h3>

            <div class="product-price">
              {% if product.price_varies %}
                From {{ product.price_min | money }}
              {% else %}
                {{ product.price | money }}
              {% endif %}

              {% if product.compare_at_price > product.price %}
                <span class="compare-price">
                  {{ product.compare_at_price | money }}
                </span>
              {% endif %}
            </div>
          </a>

          {% for option in product.options_with_values %}
            {% assign option_name = option.name | downcase %}

            {% if option_name == 'color' or option_name == 'colour' %}
              <div class="color-swatches">
                {% for value in option.values limit: 3 %}
                  <span
                    class="swatch"
                    style="background-color: {{ value | split: ' ' | last | handle }};"
                    title="{{ value | escape }}"
                    aria-label="{{ value | escape }}"
                  ></span>
                {% endfor %}
              </div>
            {% endif %}
          {% endfor %}
        </article>
      {% endfor %}

    {% else %}
      {% for i in (1..section.settings.products_to_show) %}
        <article class="product-card">
          <div class="product-media">
            {{ 'product-1' | placeholder_svg_tag: 'product-placeholder' }}

            <div class="quick-add-wrapper">
              <button
                type="button"
                class="quick-add-button"
                disabled
              >
                <span>Add to Cart</span>
              </button>
            </div>
          </div>

          <h3 class="product-title">
            Sample Product
          </h3>

          <div class="product-price">
            {{ 3999 | money }}
          </div>

          <div class="color-swatches">
            <span class="swatch" style="background-color: #000000;"></span>
            <span class="swatch" style="background-color: #556b2f;"></span>
            <span class="swatch" style="background-color: #cccccc;"></span>
          </div>
        </article>
      {% endfor %}
    {% endif %}
  </div>

  {% if section.settings.button_label != blank %}
    <div class="view-all-wrapper">
     <a
  href="{% if section.settings.button_link != blank %}{{ section.settings.button_link }}{% elsif selected_collection != blank %}{{ selected_collection.url }}{% else %}{{ routes.all_products_collection_url }}{% endif %}"
  class="view-all-btn"
>
  <span>{{ section.settings.button_label }}</span>
</a>
    </div>
  {% endif %}

  <div
    class="custom-cart-message"
    data-custom-cart-message
    role="status"
    aria-live="polite"
  >
    Added to cart
  </div>
</section>

<script>
  (function () {
    var sectionRoot = document.querySelector(
      '#shopify-section-{{ section.id }}'
    );

    if (!sectionRoot || sectionRoot.dataset.customBestsellersInitialized === 'true') {
      return;
    }

    sectionRoot.dataset.customBestsellersInitialized = 'true';

    var messageElement = sectionRoot.querySelector(
      '[data-custom-cart-message]'
    );

    var messageTimer;

    function showMessage(message) {
      if (!messageElement) return;

      clearTimeout(messageTimer);

      messageElement.textContent = message;
      messageElement.classList.add('is-visible');

      messageTimer = setTimeout(function () {
        messageElement.classList.remove('is-visible');
      }, 2200);
    }

    function updateCartCount() {
      var shopifyRoot =
        window.Shopify &&
        window.Shopify.routes &&
        window.Shopify.routes.root
          ? window.Shopify.routes.root
          : '/';

      fetch(shopifyRoot + 'cart.js', {
        headers: {
          Accept: 'application/json'
        }
      })
        .then(function (response) {
          if (!response.ok) {
            throw new Error('Unable to load cart.');
          }

          return response.json();
        })
        .then(function (cart) {
          document
            .querySelectorAll(
              '.cart-count-bubble, [data-cart-count], .m-cart-count'
            )
            .forEach(function (countElement) {
              countElement.textContent = cart.item_count;

              if (cart.item_count > 0) {
                countElement.removeAttribute('hidden');
              }
            });
        })
        .catch(function () {
          /* Theme event will still refresh compatible cart drawers */
        });
    }

    sectionRoot.addEventListener('click', function (event) {
      var button = event.target.closest('[data-custom-add-to-cart]');

      if (
        !button ||
        !sectionRoot.contains(button) ||
        button.disabled ||
        button.classList.contains('is-loading')
      ) {
        return;
      }

      event.preventDefault();

      var variantId = button.getAttribute('data-variant-id');
      var buttonLabel = button.querySelector('span');

      if (!variantId || !buttonLabel) {
        return;
      }

      var originalLabel = buttonLabel.textContent.trim();

      var shopifyRoot =
        window.Shopify &&
        window.Shopify.routes &&
        window.Shopify.routes.root
          ? window.Shopify.routes.root
          : '/';

      button.classList.add('is-loading');
      buttonLabel.textContent = 'Adding...';

      fetch(shopifyRoot + 'cart/add.js', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          Accept: 'application/json'
        },
        body: JSON.stringify({
          items: [
            {
              id: Number(variantId),
              quantity: 1
            }
          ]
        })
      })
        .then(function (response) {
          return response.json().then(function (data) {
            return {
              ok: response.ok,
              data: data
            };
          });
        })
        .then(function (result) {
          if (!result.ok || result.data.status) {
            throw new Error(
              result.data.description ||
              result.data.message ||
              'Could not add this product to cart.'
            );
          }

          document.dispatchEvent(
            new CustomEvent('cart:refresh', {
              detail: result.data
            })
          );

          document.dispatchEvent(
            new CustomEvent('cart:updated', {
              detail: result.data
            })
          );

          document.body.dispatchEvent(
            new CustomEvent('cart:build', {
              detail: result.data
            })
          );

          updateCartCount();
          showMessage('Added to cart successfully');
        })
        .catch(function (error) {
          showMessage(
            error.message || 'Something went wrong'
          );
        })
        .finally(function () {
          button.classList.remove('is-loading');
          buttonLabel.textContent = originalLabel;
        });
    });
  })();
</script>

{% schema %}
{
  "name": "Custom Best Sellers",
  "settings": [
    {
      "type": "header",
      "content": "Section Layout"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Padding Top",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 40
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Heading & Icon"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading Text",
      "default": "BEST SELLERS"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#000000"
    },
    {
      "type": "image_picker",
      "id": "divider_icon",
      "label": "Divider Center Icon",
      "info": "Leave empty to use the default icon."
    },
    {
      "type": "header",
      "content": "Products"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Select Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 5,
      "label": "Maximum products to show"
    },
    {
      "type": "range",
      "id": "products_per_row",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 5,
      "label": "Products per row - Desktop"
    },
    {
      "type": "header",
      "content": "Add to Cart Button"
    },
    {
      "type": "range",
      "id": "hover_btn_font_size",
      "label": "Button Font Size",
      "min": 9,
      "max": 16,
      "step": 1,
      "unit": "px",
      "default": 11
    },
    {
      "type": "color",
      "id": "hover_btn_bg",
      "label": "Default Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "hover_btn_color",
      "label": "Default Text Color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "hover_btn_bg_hover",
      "label": "Hover Fill Color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "hover_btn_color_hover",
      "label": "Hover Text Color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "hover_btn_border_width",
      "label": "Border Width",
      "min": 0,
      "max": 5,
      "step": 1,
      "unit": "px",
      "default": 1
    },
    {
      "type": "color",
