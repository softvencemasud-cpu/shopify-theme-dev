{% comment %}
  Jotar / NOVA - Legal & Policy Document Page Section
{% endcomment %}

<div class="jotar-page-wrap" id="jotar-legal-{{ section.id }}">
  <div class="jotar-container">
    <!-- Breadcrumbs -->
    <div class="jotar-page-breadcrumbs">
      <a href="{{ routes.root_url }}">Home</a>
      <span class="jotar-page-breadcrumbs__sep">&rsaquo;</span>
      <span class="jotar-page-breadcrumbs__current">{{ section.settings.title | default: page.title | default: 'Legal Document' }}</span>
    </div>

    <div class="jotar-legal-layout">
      <!-- Sidebar Policy Navigation Links -->
      <aside class="jotar-legal-sidebar">
        <h4>Legal Documents</h4>
        <ul class="jotar-legal-nav">
          <li><a href="/pages/terms-of-service" class="{% if request.path contains 'terms' %}is-active{% endif %}">Terms of Service</a></li>
          <li><a href="/pages/privacy-policy" class="{% if request.path contains 'privacy' %}is-active{% endif %}">Privacy Policy</a></li>
          <li><a href="/pages/refund-policy" class="{% if request.path contains 'refund' %}is-active{% endif %}">Refund Policy</a></li>
          <li><a href="/pages/cookies-policy" class="{% if request.path contains 'cookies' %}is-active{% endif %}">Cookies Policy</a></li>
        </ul>
      </aside>

      <!-- Main Legal Content -->
      <main class="jotar-legal-content">
        <span class="jotar-eyebrow">OFFICIAL POLICY</span>
        <h1 class="jotar-legal-title">{{ section.settings.title | default: page.title | default: 'Terms & Conditions' }}</h1>
        <div class="jotar-legal-date">Last Updated: {{ 'now' | date: '%B %d, %Y' }}</div>

        {%- if page.content != blank -%}
          <div class="jotar-legal-body">
            {{ page.content }}
          </div>
        {%- else -%}
          <!-- DEFAULT E-COMMERCE POLICY TEXT -->
          <div class="jotar-legal-body">
            <h2>1. Introduction & Overview</h2>
            <p>Welcome to NOVA Footwear. These Terms and Policies govern your access to and use of the website, services, and online purchases. By accessing our platform or purchasing any products, you agree to comply with and be bound by the terms detailed herein.</p>

            <h2>2. Online Store & Ordering</h2>
            <p>By placing an order on our store, you warrant that you are legally capable of entering into binding contracts and that all information provided during checkout (including billing address and payment details) is accurate and complete.</p>

            <h2>3. Pricing & Payment</h2>
            <p>All prices displayed are in USD unless otherwise specified. We reserve the right to modify pricing or cancel orders resulting from typographical errors. We accept all major debit/credit cards, PayPal, Shop Pay, and installment payment providers.</p>

            <h2>4. Intellectual Property</h2>
            <p>All trademarks, graphics, footwear designs, imagery, audio, and website layouts displayed on this site are the exclusive intellectual property of NOVA Footwear and are protected by applicable international copyright and trademark laws.</p>

            <h2>5. Limitation of Liability</h2>
            <p>In no event shall NOVA Footwear, its directors, or affiliates be liable for any indirect, punitive, or consequential damages arising out of your use or inability to use our products and website.</p>

            <h2>6. Contact Information</h2>
            <p>If you have any questions or concerns regarding our legal terms, privacy practices, or policies, please contact our legal counsel at <a href="mailto:legal@novasneakers.com">legal@novasneakers.com</a>.</p>
          </div>
        {%- endif -%}
      </main>
    </div>
  </div>
</div>

<style>
  .jotar-legal-layout {
    display: grid;
    grid-template-columns: 260px 1fr;
    gap: 50px;
    margin-top: 10px;
  }

  .jotar-legal-sidebar {
    background: #fbfbfb;
    border: 1px solid #ebebeb;
    border-radius: 16px;
    padding: 28px 24px;
    height: fit-content;
    position: sticky;
    top: 100px;
  }
  .jotar-legal-sidebar h4 {
    font-size: 13px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #888;
    margin: 0 0 16px 0;
  }
  .jotar-legal-nav { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 8px; }
  .jotar-legal-nav a {
    display: block;
    padding: 10px 14px;
    border-radius: 8px;
    font-size: 14.5px;
    font-weight: 500;
    color: #444;
    text-decoration: none;
    transition: all 0.2s ease;
  }
  .jotar-legal-nav a:hover {
    background: #f0f0f3;
    color: #111;
  }
  .jotar-legal-nav a.is-active {
    background: #111;
    color: #fff;
    font-weight: 600;
  }

  .jotar-legal-content { max-width: 820px; }
  .jotar-legal-title { font-size: clamp(28px, 4vw, 42px); font-weight: 800; text-transform: uppercase; margin: 8px 0 10px; letter-spacing: -0.02em; }
  .jotar-legal-date { font-size: 13.5px; color: #888; margin-bottom: 32px; font-weight: 500; }

  .jotar-legal-body { font-size: 15.5px; line-height: 1.8; color: #444; }
  .jotar-legal-body h2 { font-size: 20px; font-weight: 700; color: #111; margin: 32px 0 12px 0; }
  .jotar-legal-body p { margin: 0 0 18px 0; }
  .jotar-legal-body a { color: #111; font-weight: 600; }

  @media (max-width: 860px) {
    .jotar-legal-layout { grid-template-columns: 1fr; gap: 30px; }
    .jotar-legal-sidebar { position: static; }
  }
</style>

{% schema %}
{
  "name": "Jotar Legal Page",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Document Title",
      "default": "Terms of Service"
    }
  ]
}
{% endschema %}
