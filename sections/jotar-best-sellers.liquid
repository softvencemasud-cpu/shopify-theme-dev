{% comment %}
  Jotar Footwear - Black Best Sellers Carousel Section
{% endcomment %}

<section class="jotar-best-sellers" id="jotar-best-sellers-{{ section.id }}">
  <div class="jotar-container">
    <div class="jotar-section-header">
      <h2 class="jotar-section-title">{{ section.settings.heading | default: 'BEST SELLERS' }}</h2>
      {%- if section.settings.view_all_label != blank -%}
        <a
          href="{{ section.settings.collection.url | default: section.settings.view_all_url | default: routes.all_products_collection_url }}"
          class="jotar-view-all"
        >
          {{ section.settings.view_all_label }}
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>
      {%- endif -%}
    </div>

    <div class="jotar-carousel-wrapper">
      <button
        class="jotar-carousel-arrow jotar-carousel-arrow--prev"
        data-target="jotar-best-track-{{ section.id }}"
        aria-label="Previous Slide"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="15 18 9 12 15 6"></polyline>
        </svg>
      </button>

      <div class="jotar-carousel-track" id="jotar-best-track-{{ section.id }}">
        {%- assign product_limit = section.settings.products_to_show | default: 8 -%}
        {%- if section.settings.collection != blank and section.settings.collection.products_count > 0 -%}
          {%- for product in section.settings.collection.products limit: product_limit -%}
            <a href="{{ product.url }}" class="jotar-best-card">
              <div class="jotar-best-card__media">
                {%- if product.featured_media != blank -%}
                  {{
                    product.featured_media
                    | image_url: width: 400
                    | image_tag:
                      class: 'jotar-best-card__image',
                      loading: 'lazy',
                      alt: product.title
                  }}
                {%- else -%}
                  <img
                    src="{{ 'jotar-prod-01.jpg' | asset_url }}"
                    alt="{{ product.title | escape }}"
                    class="jotar-best-card__image"
                    loading="lazy"
                  >
                {%- endif -%}
              </div>
              <h3 class="jotar-best-card__title">{{ product.title }}</h3>
              <div class="jotar-best-card__price">{{ product.price | money }}</div>
            </a>
          {%- endfor -%}
        {%- else -%}
          <!-- 6 Original LeagueHub Best Seller Products -->
          <!-- 1. Urban Pulse Runner -->
          <a href="/products/urban-pulse-runner" class="jotar-best-card">
            <div class="jotar-best-card__media">
              <img src="{{ 'jotar-prod-01.jpg' | asset_url }}" alt="Urban Pulse Runner" class="jotar-best-card__image" loading="lazy">
            </div>
            <h3 class="jotar-best-card__title">Urban Pulse Runner</h3>
            <div class="jotar-best-card__price">৳ 4,990</div>
          </a>

          <!-- 2. Shadow Flex Pro -->
          <a href="/products/shadow-flex-pro" class="jotar-best-card">
            <div class="jotar-best-card__media">
              <img src="{{ 'jotar-prod-04.jpg' | asset_url }}" alt="Shadow Flex Pro" class="jotar-best-card__image" loading="lazy">
            </div>
            <h3 class="jotar-best-card__title">Shadow Flex Pro</h3>
            <div class="jotar-best-card__price">৳ 5,490</div>
          </a>

          <!-- 3. Night Circuit -->
          <a href="/products/night-circuit" class="jotar-best-card">
            <div class="jotar-best-card__media">
              <img src="{{ 'jotar-category-premium.jpg' | asset_url }}" alt="Night Circuit" class="jotar-best-card__image" loading="lazy">
            </div>
            <h3 class="jotar-best-card__title">Night Circuit</h3>
            <div class="jotar-best-card__price">৳ 6,990</div>
          </a>

          <!-- 4. Aero Cloud Lite -->
          <a href="/products/aero-cloud-lite" class="jotar-best-card">
            <div class="jotar-best-card__media">
              <img src="{{ 'jotar-prod-02.jpg' | asset_url }}" alt="Aero Cloud Lite" class="jotar-best-card__image" loading="lazy">
            </div>
            <h3 class="jotar-best-card__title">Aero Cloud Lite</h3>
            <div class="jotar-best-card__price">৳ 4,590</div>
          </a>

          <!-- 5. Nova Sprint -->
          <a href="/products/nova-sprint" class="jotar-best-card">
            <div class="jotar-best-card__media">
              <img src="{{ 'jotar-category-running.jpg' | asset_url }}" alt="Nova Sprint" class="jotar-best-card__image" loading="lazy">
            </div>
            <h3 class="jotar-best-card__title">Nova Sprint</h3>
            <div class="jotar-best-card__price">৳ 5,990</div>
          </a>

          <!-- 6. Mono Street High -->
          <a href="/products/mono-street-high" class="jotar-best-card">
            <div class="jotar-best-card__media">
              <img src="{{ 'jotar-category-sneakers.jpg' | asset_url }}" alt="Mono Street High" class="jotar-best-card__image" loading="lazy">
            </div>
            <h3 class="jotar-best-card__title">Mono Street High</h3>
            <div class="jotar-best-card__price">৳ 5,290</div>
          </a>
        {%- endif -%}
      </div>

      <button
        class="jotar-carousel-arrow jotar-carousel-arrow--next"
        data-target="jotar-best-track-{{ section.id }}"
        aria-label="Next Slide"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="9 18 15 12 9 6"></polyline>
        </svg>
      </button>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Best Sellers Carousel",
  "tag": "section",
  "class": "section-jotar-best-sellers",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section Heading",
      "default": "BEST SELLERS"
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "View All Label",
      "default": "VIEW ALL"
    },
    {
      "type": "url",
      "id": "view_all_url",
      "label": "View All Link"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Select Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 4,
      "max": 16,
      "step": 1,
      "default": 8,
      "label": "Products to Show"
    }
  ],
  "presets": [
    {
      "name": "Best Sellers Carousel"
    }
  ]
}
{% endschema %}
