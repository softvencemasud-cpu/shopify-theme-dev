{% comment %}
  Jotar Footwear - Exact Reference Contact Us Page
{% endcomment %}

<div class="jotar-contact" id="jotar-contact-{{ section.id }}">
  <div class="jotar-container">
    <div class="jotar-contact__grid">
      <!-- 1. LEFT COLUMN: Contact Details & Info -->
      <div class="jotar-contact__info-col">
        <span class="jotar-contact-eyebrow">{{ section.settings.eyebrow | default: 'GET IN TOUCH' }}</span>
        <h1 class="jotar-contact__title">{{ section.settings.heading | default: "We're Here<br>To Help" }}</h1>
        <p class="jotar-contact__desc">
          {{ section.settings.subtext | default: 'Have a question or need assistance? Our team is ready to help you with anything you need.' }}
        </p>

        <div class="jotar-contact__methods-list">
          <!-- Item 1: Email Us -->
          <div class="jotar-contact-method-item">
            <div class="jotar-contact-method-icon">
              <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="2" y="4" width="20" height="16" rx="2"></rect>
                <path d="M22 7l-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
              </svg>
            </div>
            <div class="jotar-contact-method-text">
              <h4>Email Us</h4>
              <a href="mailto:{{ section.settings.email | default: 'support@novasneakers.com' }}" class="jotar-contact-link">
                {{ section.settings.email | default: 'support@novasneakers.com' }}
              </a>
              <span class="jotar-contact-subtext">We reply within 24 hours</span>
            </div>
          </div>

          <!-- Item 2: Call Us -->
          <div class="jotar-contact-method-item">
            <div class="jotar-contact-method-icon">
              <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
              </svg>
            </div>
            <div class="jotar-contact-method-text">
              <h4>Call Us</h4>
              <a href="tel:{{ section.settings.phone | default: '+15551234567' }}" class="jotar-contact-link">
                {{ section.settings.phone | default: '+1 (555) 123-4567' }}
              </a>
              <span class="jotar-contact-subtext">Mon – Fri: 9AM – 6PM</span>
            </div>
          </div>

          <!-- Item 3: Visit Us -->
          <div class="jotar-contact-method-item">
            <div class="jotar-contact-method-icon">
              <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                <circle cx="12" cy="10" r="3"></circle>
              </svg>
            </div>
            <div class="jotar-contact-method-text">
              <h4>Visit Us</h4>
              <span class="jotar-contact-link-static">
                {{ section.settings.address | default: '123 Sneaker Street' }}
              </span>
              <span class="jotar-contact-subtext">{{ section.settings.address_sub | default: 'New York, NY 10001, USA' }}</span>
            </div>
          </div>

          <!-- Item 4: Live Chat -->
          <div class="jotar-contact-method-item">
            <div class="jotar-contact-method-icon">
              <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
              </svg>
            </div>
            <div class="jotar-contact-method-text">
              <h4>Live Chat</h4>
              <span class="jotar-contact-link-static">Chat with our support team</span>
              <span class="jotar-contact-subtext">Mon – Fri: 9AM – 6PM</span>
            </div>
          </div>
        </div>
      </div>

      <!-- 2. MIDDLE COLUMN: Send Us a Message Card Form -->
      <div class="jotar-contact__form-col">
        <div class="jotar-contact-card">
          <h2 class="jotar-contact-card__title">{{ section.settings.form_heading | default: 'Send Us a Message' }}</h2>
          <p class="jotar-contact-card__desc">
            {{ section.settings.form_subtext | default: "Fill out the form below and we'll get back to you as soon as possible." }}
          </p>

          {%- form 'contact', id: 'ContactForm', class: 'jotar-contact-form' -%}
            {%- if form.posted_successfully? -%}
              <div class="jotar-form-alert jotar-form-alert--success">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                  <polyline points="22 4 12 14.01 9 11.01"></polyline>
                </svg>
                <span>Thank you! Your message has been sent successfully. We will reply shortly.</span>
              </div>
            {%- elsif form.errors -%}
              <div class="jotar-form-alert jotar-form-alert--error">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
                  <circle cx="12" cy="12" r="10"></circle>
                  <line x1="12" y1="8" x2="12" y2="12"></line>
                  <line x1="12" y1="16" x2="12.01" y2="16"></line>
                </svg>
                <span>Please fill in all required fields accurately.</span>
              </div>
            {%- endif -%}

            <!-- Row 1: Name + Email (2 Columns) -->
            <div class="jotar-contact-form__row-split">
              <!-- Name Input -->
              <div class="jotar-input-group">
                <span class="jotar-input-icon">
                  <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                    <circle cx="12" cy="7" r="4"></circle>
                  </svg>
                </span>
                <input
                  type="text"
                  name="contact[name]"
                  id="ContactForm-name"
                  class="jotar-input-field"
                  placeholder="Your Name"
                  value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}"
                  required
                >
              </div>

              <!-- Email Input -->
              <div class="jotar-input-group">
                <span class="jotar-input-icon">
                  <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2">
                    <rect x="2" y="4" width="20" height="16" rx="2"></rect>
                    <path d="M22 7l-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
                  </svg>
                </span>
                <input
                  type="email"
                  name="contact[email]"
                  id="ContactForm-email"
                  class="jotar-input-field"
                  placeholder="Your Email"
                  value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
                  spellcheck="false"
                  autocomplete="email"
                  autocapitalize="off"
                  required
                >
              </div>
            </div>

            <!-- Row 2: Phone Number -->
            <div class="jotar-input-group">
              <span class="jotar-input-icon">
                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
                </svg>
              </span>
              <input
                type="tel"
                name="contact[phone]"
                id="ContactForm-phone"
                class="jotar-input-field"
                placeholder="Phone Number"
                value="{% if form.phone %}{{ form.phone }}{% elsif customer %}{{ customer.phone }}{% endif %}"
              >
            </div>

            <!-- Row 3: Your Message Textarea -->
            <div class="jotar-input-group jotar-input-group--textarea">
              <span class="jotar-input-icon jotar-input-icon--top">
                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M12 20h9"></path>
                  <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path>
                </svg>
              </span>
              <textarea
                rows="5"
                name="contact[body]"
                id="ContactForm-body"
                class="jotar-input-field jotar-textarea-field"
                placeholder="Your Message"
                required
              >{{ form.body }}</textarea>
            </div>

            <!-- Submit Button -->
            <div class="jotar-contact-form__submit-wrap">
              <button type="submit" class="jotar-contact-submit-btn">
                <span>Send Message</span>
                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <line x1="22" y1="2" x2="11" y2="13"></line>
                  <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
                </svg>
              </button>
            </div>
          {%- endform -%}
        </div>
      </div>

      <!-- 3. RIGHT COLUMN: Sneaker Visual Card -->
      <div class="jotar-contact__image-col">
        <div class="jotar-contact-image-wrap">
          <img
            src="{{ 'jotar-prod-02.jpg' | asset_url }}"
            alt="LeagueHub Sneaker Photography"
            class="jotar-contact-side-img"
            loading="eager"
          >
        </div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Jotar Contact Page",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "GET IN TOUCH"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "We're Here<br>To Help"
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Subtext",
      "default": "Have a question or need assistance? Our team is ready to help you with anything you need."
    },
    {
      "type": "text",
      "id": "email",
      "label": "Email Address",
      "default": "support@novasneakers.com"
    },
    {
      "type": "text",
      "id": "phone",
      "label": "Phone Number",
      "default": "+1 (555) 123-4567"
    },
    {
      "type": "text",
      "id": "address",
      "label": "Street Address",
      "default": "123 Sneaker Street"
    },
    {
      "type": "text",
      "id": "address_sub",
      "label": "City, State, Zip",
      "default": "New York, NY 10001, USA"
    },
    {
      "type": "text",
      "id": "form_heading",
      "label": "Form Heading",
      "default": "Send Us a Message"
    },
    {
      "type": "text",
      "id": "form_subtext",
      "label": "Form Subtext",
      "default": "Fill out the form below and we'll get back to you as soon as possible."
    }
  ],
  "presets": [
    {
      "name": "Jotar Contact Page"
    }
  ]
}
{% endschema %}
