{% comment %}
  Jotar Footwear - Full-Width Promotional Banner Section
{% endcomment %}

<section
  class="jotar-promo-banner"
  id="jotar-promo-banner-{{ section.id }}"
  style="min-height: {{ section.settings.section_height | default: 480 }}px;"
>
  {%- if section.settings.bg_image != blank -%}
    {{
      section.settings.bg_image
      | image_url: width: 2000
      | image_tag:
        class: 'jotar-promo-banner__bg',
        loading: 'lazy',
        alt: section.settings.heading
    }}
  {%- else -%}
    <img
      src="{{ 'jotar-lifestyle-banner.jpg' | asset_url }}"
      alt="{{ section.settings.heading | default: 'Built For Every Step' | escape }}"
      class="jotar-promo-banner__bg"
      loading="lazy"
      width="1920"
      height="1080"
    >
  {%- endif -%}

  <div
    class="jotar-promo-banner__overlay"
    style="opacity: {{ section.settings.overlay_opacity | default: 85 | divided_by: 100.0 }};"
  ></div>

  <div class="jotar-container jotar-promo-banner__container">
    <div class="jotar-promo-banner__content">
      {%- if section.settings.heading != blank -%}
        <h2 class="jotar-promo-banner__heading">
          {{ section.settings.heading }}
        </h2>
      {%- endif -%}

      {%- if section.settings.description != blank -%}
        <p class="jotar-promo-banner__description">
          {{ section.settings.description }}
        </p>
      {%- endif -%}

      {%- if section.settings.btn_label != blank -%}
        <a
          href="{{ section.settings.btn_url | default: routes.all_products_collection_url }}"
          class="jotar-btn jotar-btn--white"
        >
          {{ section.settings.btn_label }}
        </a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Promotional Banner",
  "tag": "section",
  "class": "section-jotar-promo-banner",
  "settings": [
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "BUILT FOR\nEVERY STEP"
    },
    {
      "type": "text",
      "id": "description",
      "label": "Description",
      "default": "Designed to move with you."
    },
    {
      "type": "text",
      "id": "btn_label",
      "label": "Button Label",
      "default": "EXPLORE COLLECTION"
    },
    {
      "type": "url",
      "id": "btn_url",
      "label": "Button URL"
    },
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background Lifestyle Image"
    },
    {
      "type": "range",
      "id": "section_height",
      "min": 350,
      "max": 700,
      "step": 10,
      "default": 480,
      "unit": "px",
      "label": "Section Height"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "default": 85,
      "unit": "%",
      "label": "Overlay Opacity"
    }
  ],
  "presets": [
    {
      "name": "Promotional Banner"
    }
  ]
}
{% endschema %}
