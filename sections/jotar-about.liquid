{% comment %}
  Jotar Footwear / NOVA - Exact Reference About Us Page
{% endcomment %}

<div class="jotar-about" id="jotar-about-{{ section.id }}">
  <!-- 1. HERO SECTION -->
  <section class="jotar-about-hero">
    <div class="jotar-container">
      <div class="jotar-about-hero__grid">
        <div class="jotar-about-hero__content">
          <span class="jotar-about-eyebrow">OUR STORY</span>
          <h1 class="jotar-about-hero__title">BUILT FOR<br>EVERY STEP</h1>
          <p class="jotar-about-hero__desc">
            NOVA was created with a simple mission — to craft sneakers that combine performance, comfort, and modern design for everyday movement.
          </p>
          <a href="{{ section.settings.collection_url | default: '/collections/all' }}" class="jotar-about-btn-primary">
            OUR COLLECTION
          </a>
        </div>
        <div class="jotar-about-hero__media">
          <img
            src="{{ 'jotar-lifestyle-banner.jpg' | asset_url }}"
            alt="Built For Every Step"
            class="jotar-about-hero__img"
            loading="eager"
          >
        </div>
      </div>
    </div>
  </section>

  <!-- 2. BRAND STORY & FOUNDER SIGNATURE -->
  <section class="jotar-about-story">
    <div class="jotar-container">
      <div class="jotar-about-story__grid">
        <div class="jotar-about-story__content">
          <span class="jotar-about-eyebrow">OUR STORY</span>
          <h2 class="jotar-about-story__title">Passion. Performance.<br>Purpose.</h2>
          <div class="jotar-about-story__text">
            <p>
              NOVA started with a passion for sneakers and a belief that great shoes can inspire confidence and drive. We focus on premium materials, innovative design, and attention to detail to deliver sneakers that not only look sharp but feel exceptional.
            </p>
            <p>
              From city streets to everyday adventures, we build sneakers that move with you.
            </p>
          </div>
          <div class="jotar-about-signature-wrap">
            <svg class="jotar-about-signature-svg" viewBox="0 0 160 45" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M5 25C25 15 45 8 60 20C75 32 80 5 95 18C110 30 120 12 135 22C145 28 150 18 155 24" stroke="#111111" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
              <path d="M30 35C45 32 85 30 120 34" stroke="#111111" stroke-width="2" stroke-linecap="round"/>
            </svg>
            <span class="jotar-about-founder-title">Founder, NOVA</span>
          </div>
        </div>
        <div class="jotar-about-story__media">
          <img
            src="{{ 'jotar-about-store.jpg' | asset_url }}"
            alt="NOVA Flagship Store & Studio"
            class="jotar-about-story__img"
            loading="lazy"
          >
        </div>
      </div>
    </div>
  </section>

  <!-- 3. 4 CORE PILLARS STRIP -->
  <section class="jotar-about-pillars">
    <div class="jotar-container">
      <div class="jotar-about-pillars__grid">
        <div class="jotar-about-pillar-card">
          <div class="jotar-about-pillar-icon">
            <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="8" r="7"></circle>
              <polyline points="8.21 13.89 7 23 12 20 17 23 15.79 13.88"></polyline>
            </svg>
          </div>
          <h3 class="jotar-about-pillar-title">Premium Quality</h3>
          <p class="jotar-about-pillar-desc">High-grade materials and strict quality control.</p>
        </div>

        <div class="jotar-about-pillar-card">
          <div class="jotar-about-pillar-icon">
            <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M20.24 12.24a6 6 0 0 0-8.49-8.49L5 10.5V19h8.5z"></path>
              <line x1="16" y1="8" x2="2" y2="22"></line>
              <line x1="17.5" y1="15" x2="9" y2="15"></line>
            </svg>
          </div>
          <h3 class="jotar-about-pillar-title">All-Day Comfort</h3>
          <p class="jotar-about-pillar-desc">Engineered for maximum comfort and support.</p>
        </div>

        <div class="jotar-about-pillar-card">
          <div class="jotar-about-pillar-icon">
            <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z"></path>
              <path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12"></path>
            </svg>
          </div>
          <h3 class="jotar-about-pillar-title">Sustainable Mindset</h3>
          <p class="jotar-about-pillar-desc">We care about reducing our environmental impact.</p>
        </div>

        <div class="jotar-about-pillar-card">
          <div class="jotar-about-pillar-icon">
            <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
            </svg>
          </div>
          <h3 class="jotar-about-pillar-title">Made for You</h3>
          <p class="jotar-about-pillar-desc">Designed for your lifestyle, made to stand out.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 4. WHAT WE STAND FOR (VALUES GRID) -->
  <section class="jotar-about-values">
    <div class="jotar-container">
      <div class="jotar-about-values__grid">
        <div class="jotar-about-values__content">
          <span class="jotar-about-eyebrow">OUR VALUES</span>
          <h2 class="jotar-about-values__title">What We Stand For</h2>
          <div class="jotar-about-title-divider"></div>

          <div class="jotar-about-values-list">
            <div class="jotar-about-value-item">
              <div class="jotar-about-value-icon">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5">
                  <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
                </svg>
              </div>
              <div class="jotar-about-value-text">
                <h4>Quality First</h4>
                <p>We never compromise on the quality of our materials and craftsmanship.</p>
              </div>
            </div>

            <div class="jotar-about-value-item">
              <div class="jotar-about-value-icon">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5">
                  <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                  <circle cx="9" cy="7" r="4"></circle>
                  <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                  <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                </svg>
              </div>
              <div class="jotar-about-value-text">
                <h4>Customer Focused</h4>
                <p>Your satisfaction drives everything we do, from design to delivery.</p>
              </div>
            </div>

            <div class="jotar-about-value-item">
              <div class="jotar-about-value-icon">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5">
                  <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
                </svg>
              </div>
              <div class="jotar-about-value-text">
                <h4>Always Evolving</h4>
                <p>We push boundaries to bring innovative designs and better performance.</p>
              </div>
            </div>
          </div>
        </div>
        <div class="jotar-about-values__media">
          <img
            src="{{ 'jotar-category-casual.jpg' | asset_url }}"
            alt="Design Process & Craftsmanship"
            class="jotar-about-values__img"
            loading="lazy"
          >
        </div>
      </div>
    </div>
  </section>

  <!-- 5. THE PEOPLE BEHIND NOVA (DARK CRAFTSMANSHIP SECTION) -->
  <section class="jotar-about-team-dark">
    <div class="jotar-container">
      <div class="jotar-about-team__grid">
        <div class="jotar-about-team__media">
          <img
            src="{{ 'jotar-trend-01.jpg' | asset_url }}"
            alt="Crafted by People Who Care"
            class="jotar-about-team__img"
            loading="lazy"
          >
        </div>
        <div class="jotar-about-team__content">
          <span class="jotar-about-eyebrow jotar-about-eyebrow--light">THE PEOPLE BEHIND NOVA</span>
          <h2 class="jotar-about-team__title">Crafted by People<br>Who Care</h2>
          <div class="jotar-about-title-divider jotar-about-title-divider--white"></div>
          <p class="jotar-about-team__desc">
            Our team of designers, engineers, and craftspeople share a passion for sneakers and a commitment to excellence. Every pair is a result of hard work, creativity, and attention to every little detail.
          </p>
          <a href="{{ section.settings.team_url | default: '/pages/contact' }}" class="jotar-about-btn-outline">
            MEET THE TEAM
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- 6. METRICS / STATS COUNTER BAR -->
  <section class="jotar-about-stats">
    <div class="jotar-container">
      <div class="jotar-about-stats__grid">
        <div class="jotar-about-stat-item">
          <div class="jotar-about-stat-icon">
            <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M20.24 12.24a6 6 0 0 0-8.49-8.49L5 10.5V19h8.5z"></path>
              <line x1="16" y1="8" x2="2" y2="22"></line>
            </svg>
          </div>
          <div class="jotar-about-stat-text">
            <span class="jotar-about-stat-num">25K+</span>
            <span class="jotar-about-stat-label">Pairs Sold</span>
          </div>
        </div>

        <div class="jotar-about-stat-item">
          <div class="jotar-about-stat-icon">
            <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
              <circle cx="9" cy="7" r="4"></circle>
            </svg>
          </div>
          <div class="jotar-about-stat-text">
            <span class="jotar-about-stat-num">15K+</span>
            <span class="jotar-about-stat-label">Happy Customers</span>
          </div>
        </div>

        <div class="jotar-about-stat-item">
          <div class="jotar-about-stat-icon">
            <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="10"></circle>
              <line x1="2" y1="12" x2="22" y2="12"></line>
              <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
            </svg>
          </div>
          <div class="jotar-about-stat-text">
            <span class="jotar-about-stat-num">30+</span>
            <span class="jotar-about-stat-label">Countries Served</span>
          </div>
        </div>

        <div class="jotar-about-stat-item">
          <div class="jotar-about-stat-icon">
            <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="2">
              <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
            </svg>
          </div>
          <div class="jotar-about-stat-text">
            <span class="jotar-about-stat-num">4.9/5</span>
            <span class="jotar-about-stat-label">Customer Rating</span>
          </div>
        </div>
      </div>
    </div>
  </section>
</div>

{% schema %}
{
  "name": "Jotar About Us",
  "settings": [
    {
      "type": "url",
      "id": "collection_url",
      "label": "Collection Link URL"
    },
    {
      "type": "url",
      "id": "team_url",
      "label": "Team Link URL"
    }
  ],
  "presets": [
    {
      "name": "Jotar About Us"
    }
  ]
}
{% endschema %}
